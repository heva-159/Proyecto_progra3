@page "/tutor/tarifas"
@using TutorPUCP.Servicios
@inject AcademicoApi Api
@inject RolActual EstadoSesion

<PageTitle>Mis tarifas</PageTitle>

<EncabezadoPagina Icono="bi-cash-coin" Titulo="Mis Tarifas por Hora"
                  Subtitulo="Establece y actualiza cuánto cobrarás por cada hora de asesoría académica.">
    <a href="/tutor" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i>Volver al Panel</a>
</EncabezadoPagina>

@* Regla del sistema (RF008) *@
<div class="nota aviso-info mb-4" role="note">
    <i class="bi bi-info-circle-fill"></i>
    <div>
        <strong>Regla del sistema:</strong>
        Solo puedes registrar y modificar tarifas en aquellos cursos donde tu postulación figure con estado
        <EstadoBadge Estado="APROBADA" />. Si deseas dictar un curso nuevo, primero debes
        <a href="/tutor/postular">enviar tu postulación aquí</a>.
    </div>
</div>

<ModalListo @ref="listo" />

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-octagon-fill"></i><div>@mensajeError</div>
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

<div class="row g-4">
    @* Tabla de gestión de tarifas *@
    <div class="col-xl-8">
        <div class="card tarjeta-form">
            <div class="card-header cabecera">
                <h2 class="card-titulo">Catálogo de Cursos Habilitados</h2>
            </div>
            @if (cargando)
            {
                <div class="estado-vacio">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="small mt-2">Cargando tarifas...</div>
                </div>
            }
            else if (listaTarifas == null || listaTarifas.Count == 0)
            {
                <div class="estado-vacio">
                    <i class="bi bi-journal-x"></i>
                    <div class="fw-semibold">No tienes cursos habilitados con postulación aprobada para registrar tarifas.</div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle tabla-tp">
                        <thead class="table-primary">
                            <tr>
                                <th>Curso</th>
                                <th>Acreditación</th>
                                <th>Tarifa por Hora (S/)</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in listaTarifas)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@item.CursoNombre</div>
                                        <small class="text-muted">Código: @item.CursoCodigo</small>
                                    </td>
                                    <td><EstadoBadge Estado="APROBADA" /></td>
                                    <td>
                                        <div class="input-group" style="max-width: 220px; min-width: 180px;">
                                            <span class="input-group-text fw-semibold">S/</span>
                                            <input type="number"
                                                   class="form-control"
                                                   aria-label="@($"Tarifa por hora de {item.CursoNombre}")"
                                                   @bind="item.MontoPorHora"
                                                   step="2.50"
                                                   min="15"
                                                   max="120" />
                                            <span class="input-group-text text-muted small">/ hora</span>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-primary btn-sm px-3" @onclick="() => GuardarTarifa(item)">
                                            <i class="bi bi-check-lg me-1"></i>Guardar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* Consejos y políticas *@
    <div class="col-xl-4">
        <div class="card">
            <div class="card-body">
                <h2 class="card-titulo mb-2"><i class="bi bi-lightbulb me-2 text-primary"></i>Recomendaciones sobre las Tarifas</h2>
                <ul class="mb-0 small text-muted ps-3">
                    <li class="mb-1">El rango de precio sugerido por la facultad está entre <strong>S/ 25.00</strong> y <strong>S/ 45.00</strong> por hora.</li>
                    <li>Los estudiantes verán este precio publicado cuando utilicen el buscador de tutores.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@code {
    private ModalListo listo = default!;
    private string cursoGuardado = "";
    private decimal montoGuardado = 0;
    private string? mensajeError = null;
    private bool cargando = true;

    // Lista real obtenida desde MySQL mediante REST
    private List<TarifaItem> listaTarifas = new();

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        // Obtenemos el ID del tutor logueado (o 1 por defecto para pruebas)
        int idTutorActual = EstadoSesion.Usuario?.IdUsuario ?? 1;

        var (tarifas, error) = await Api.ListarTarifasPorTutorAsync(idTutorActual);

        if (error != null)
        {
            mensajeError = error;
        }
        else if (tarifas != null && tarifas.Count > 0)
        {
            listaTarifas = tarifas.Select(t => new TarifaItem
            {
                IdTarifa = t.IdTarifa,
                IdCurso = t.IdCurso,
                CursoCodigo = t.CursoCodigo,
                CursoNombre = t.CursoNombre,
                MontoPorHora = t.MontoPorHora
            }).ToList();
        }
        else
        {
            // Si el tutor aún no tiene tarifas en BD, cargamos los cursos predeterminados
            listaTarifas = new()
            {
                new TarifaItem { IdCurso = 1, CursoCodigo = "1INF30", CursoNombre = "Programación 3", MontoPorHora = 35.00m },
                new TarifaItem { IdCurso = 2, CursoCodigo = "1INF01", CursoNombre = "Algoritmia", MontoPorHora = 30.00m }
            };
        }
        cargando = false;
    }

    private async Task GuardarTarifa(TarifaItem item)
    {
        mensajeError = null;

        int idTutorActual = EstadoSesion.Usuario?.IdUsuario ?? 1;
        var peticion = new GuardarTarifaDto(idTutorActual, item.IdCurso, item.MontoPorHora);

        var (resultado, error) = await Api.GuardarTarifaAsync(peticion);

        if (error != null)
        {
            mensajeError = error;
        }
        else
        {
            cursoGuardado = $"{item.CursoCodigo} - {item.CursoNombre}";
            montoGuardado = item.MontoPorHora;
            await listo.MostrarAsync("Tarifa actualizada", $"S/ {montoGuardado:0.00} por hora para {cursoGuardado}.", "bi-cash-coin");
        }
    }

    public class TarifaItem
    {
        public int IdTarifa { get; set; }
        public int IdCurso { get; set; }
        public string CursoCodigo { get; set; } = "";
        public string CursoNombre { get; set; } = "";
        public decimal MontoPorHora { get; set; }
    }
}
