@page "/tutor/tarifas"
@using TutorPUCP.Servicios
@inject AcademicoApi Api
@inject RolActual EstadoSesion

<PageTitle>Mis tarifas</PageTitle>

@* =============================================================================
   ENCABEZADO Y BOTÓN DE REGRESO
   ============================================================================= *@
<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="text-primary fw-bold mb-1">Mis Tarifas por Hora</h2>
        <p class="text-muted mb-0">Establece y actualiza cuánto cobrarás por cada hora de asesoría académica</p>
    </div>
    <a href="/tutor" class="btn btn-outline-secondary btn-sm">
        ← Volver al Panel
    </a>
</div>

@* =============================================================================
   ALERTA INFORMATIVA DEL REQUERIMIENTO RF008
   ============================================================================= *@
<div class="alert alert-info shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
    <i class="bi bi-info-circle-fill fs-4 me-3"></i>
    <div>
        <strong>Regla del sistema:</strong><br />
        Solo puedes registrar y modificar tarifas en aquellos cursos donde tu postulación figure con estado
        <span class="badge bg-success">APROBADA</span>. Si deseas dictar un curso nuevo, primero debes
        <a href="/tutor/postular" class="alert-link">enviar tu postulación aquí</a>.
    </div>
</div>

@* =============================================================================
   ALERTAS DE CONFIRMACIÓN O ERROR (REST)
   ============================================================================= *@
@if (tarifaActualizada)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert">
        <strong>¡Tarifa actualizada con éxito!</strong> Se guardó un precio de
        <strong>S/ @montoGuardado.ToString("0.00") por hora</strong> para el curso <strong>@cursoGuardado</strong>.
        <button type="button" class="btn-close" @onclick="() => tarifaActualizada = false"></button>
    </div>
}

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i> @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

@* =============================================================================
   TABLA DE GESTIÓN DE TARIFAS
   ============================================================================= *@
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-0">
        <h5 class="fw-bold mb-0 text-dark">Catálogo de Cursos Habilitados</h5>
    </div>
    <div class="card-body p-0">
        @if (cargando)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2 mb-0">Cargando tarifas...</p>
            </div>
        }
        else if (listaTarifas == null || listaTarifas.Count == 0)
        {
            <div class="p-4 text-center text-muted">
                No tienes cursos habilitados con postulación aprobada para registrar tarifas.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 35%;">Curso</th>
                            <th style="width: 20%;">Acreditación</th>
                            <th style="width: 30%;">Tarifa por Hora (S/)</th>
                            <th style="width: 15%;" class="text-center">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in listaTarifas)
                        {
                            <tr>
                                @* 1. Datos del Curso *@
                                <td class="ps-3">
                                    <span class="fw-semibold text-dark">@item.CursoNombre</span><br />
                                    <small class="text-muted">Código: @item.CursoCodigo</small>
                                </td>
                                @* 2. Insignia de Aprobado *@
                                <td>
                                    <span class="badge bg-success">APROBADA</span>
                                </td>
                                @* 3. Input interactivo para cambiar la tarifa *@
                                <td>
                                    <div class="input-group" style="max-width: 220px;">
                                        <span class="input-group-text fw-bold">S/</span>
                                        <input type="number"
                                               class="form-control"
                                               @bind="item.MontoPorHora"
                                               step="2.50"
                                               min="15"
                                               max="120" />
                                        <span class="input-group-text text-muted small">/ hora</span>
                                    </div>
                                </td>
                                @* 4. Botón para guardar la fila individual *@
                                <td class="text-center">
                                    <button class="btn btn-outline-success btn-sm px-3 shadow-sm"
                                            @onclick="() => GuardarTarifa(item)">
                                        Guardar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* =============================================================================
   TARJETA DE CONSEJOS Y POLÍTICAS 
   ============================================================================= *@
<div class="card border-0 bg-light p-3 shadow-sm mb-4">
    <h6 class="fw-bold text-secondary mb-2">Recomendaciones sobre las Tarifas:</h6>
    <ul class="mb-0 small text-muted">
        <li>El rango de precio sugerido por la facultad está entre <strong>S/ 25.00</strong> y <strong>S/ 45.00</strong> por hora.</li>
        <li>Los estudiantes verán este precio publicado cuando utilicen el buscador de tutores.</li>
        
    </ul>
</div>

@* =============================================================================
   LÓGICA EN C# (RF008)
   ============================================================================= *@
@code {
    private bool tarifaActualizada = false;
    private string cursoGuardado = "";
    private decimal montoGuardado = 0;
    private string? mensajeError = null;
    private bool cargando = true;

    // Lista real obtenida desde MySQL mediante REST
    private List<TarifaItem> listaTarifas = new();

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        // Obtenemos el ID del tutor logueado (o 1 por defecto para pruebas)
        int idTutorActual = EstadoSesion.Usuario?.IdUsuario ?? 1;

        var (tarifas, error) = await Api.ListarTarifasPorTutorAsync(idTutorActual);

        if (error != null)
        {
            mensajeError = error;
        }
        else if (tarifas != null && tarifas.Count > 0)
        {
            listaTarifas = tarifas.Select(t => new TarifaItem
            {
                IdTarifa = t.IdTarifa,
                IdCurso = t.IdCurso,
                CursoCodigo = t.CursoCodigo,
                CursoNombre = t.CursoNombre,
                MontoPorHora = t.MontoPorHora
            }).ToList();
        }
        else
        {
            // Si el tutor aún no tiene tarifas en BD, cargamos los cursos predeterminados
            listaTarifas = new()
            {
                new TarifaItem { IdCurso = 1, CursoCodigo = "1INF30", CursoNombre = "Programación 3", MontoPorHora = 35.00m },
                new TarifaItem { IdCurso = 2, CursoCodigo = "1INF01", CursoNombre = "Algoritmia", MontoPorHora = 30.00m }
            };
        }
        cargando = false;
    }

    private async Task GuardarTarifa(TarifaItem item)
    {
        tarifaActualizada = false;
        mensajeError = null;

        int idTutorActual = EstadoSesion.Usuario?.IdUsuario ?? 1;
        var peticion = new GuardarTarifaDto(idTutorActual, item.IdCurso, item.MontoPorHora);

        var (resultado, error) = await Api.GuardarTarifaAsync(peticion);

        if (error != null)
        {
            mensajeError = error;
        }
        else
        {
            cursoGuardado = $"{item.CursoCodigo} - {item.CursoNombre}";
            montoGuardado = item.MontoPorHora;
            tarifaActualizada = true;
        }
    }

    public class TarifaItem
    {
        public int IdTarifa { get; set; }
        public int IdCurso { get; set; }
        public string CursoCodigo { get; set; } = "";
        public string CursoNombre { get; set; } = "";
        public decimal MontoPorHora { get; set; }
    }
}
