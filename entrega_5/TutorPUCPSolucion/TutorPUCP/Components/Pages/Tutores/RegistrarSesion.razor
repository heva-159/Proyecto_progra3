@page "/tutor/sesiones/nueva"
@using System.Globalization
@inject SesionRestService Rest
@inject RolActual RolActual

@* Requisito: RF011. Los cursos, temas y estudiantes vienen de la BD a través del servicio REST (GestorSesionesRecurso). *@

<PageTitle>Registrar sesión</PageTitle>

<Toasts class="p-3" Messages="avisos" AutoHide="true" Delay="4500" Placement="ToastsPlacement.TopRight" />

<div class="titulo-pagina">
    <div class="d-flex align-items-center gap-3">
        <span class="icono-titulo"><i class="bi bi-calendar-plus-fill"></i></span>
        <div>
            <h1 class="h3">Registrar sesión</h1>
            <p>Agenda una tutoría con un estudiante. La sesión se crea como Programada.</p>
        </div>
    </div>
</div>

@if (cargando)
{
    <div class="card"><div class="estado-vacio">
        <div class="spinner-border text-primary mb-2" role="status"></div>
        <div class="fw-semibold">Cargando tus cursos...</div>
    </div></div>
}
else if (errorCarga is not null)
{
    <div class="card"><div class="estado-vacio">
        <i class="bi bi-wifi-off"></i>
        <div class="fw-semibold">No se pudieron cargar tus cursos</div>
        <div class="small">@errorCarga</div>
    </div></div>
}
else if (registrada is not null)
{
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body text-center py-4">
                    <div class="exito-icono"><i class="bi bi-check-lg"></i></div>
                    <h2 class="h4">¡Sesión registrada!</h2>
                    <p class="text-muted">
                        La sesión N.º @registrada.IdSesion de <b>@registrada.Curso</b> con <b>@registrada.Estudiante</b> quedó
                        <span class="badge text-bg-primary">Programada</span> para el @InicioTexto
                    </p>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <a class="btn btn-primary" href="@($"/sesiones/detalle?id={registrada.IdSesion}")">Ver la sesión</a>
                        <a class="btn btn-outline-primary" href="/sesiones">Ver mis sesiones</a>
                        <button type="button" class="btn btn-outline-secondary" @onclick="RegistrarOtra">Registrar otra</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card entrar" style="--i: 0;">
                <div class="card-body">
                    @if (UsaTutorDePrueba)
                    {
                        <div class="nota small d-flex gap-2 mb-3">
                            <i class="bi bi-person-exclamation text-primary mt-1"></i>
                            <div>No hay sesión iniciada: se registra como la tutora de prueba (usuario @TutorDePrueba). <a href="/login/usuario">Inicia sesión</a> para usar tu cuenta.</div>
                        </div>
                    }
                    <div class="nota small d-flex gap-2 mb-4">
                        <i class="bi bi-info-circle text-primary mt-1"></i>
                        <div>Solo aparecen los cursos activos en los que tu postulación está aprobada. ¿Te falta alguno? <a href="/tutor/postular">Postula aquí</a>.</div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="estudiante" class="form-label fw-semibold">Estudiante</label>
                            <select id="estudiante" class="form-select" @bind="idEstudiante">
                                <option value="">Elige un estudiante</option>
                                @foreach (var e in opciones.Estudiantes)
                                {
                                    <option value="@e.IdUsuario">@e.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="curso" class="form-label fw-semibold">Curso</label>
                            <select id="curso" class="form-select" @bind="idCurso" @bind:after="AlCambiarCurso">
                                <option value="">Elige un curso</option>
                                @foreach (var c in opciones.Cursos)
                                {
                                    <option value="@c.IdCurso">@($"{c.Nombre} · {TarifaTexto(c.Tarifa)}")</option>
                                }
                            </select>
                            @if (!opciones.Cursos.Any())
                            {
                                <div class="form-text text-danger">Todavía no tienes cursos con postulación aprobada.</div>
                            }
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold d-block">Temas de la sesión</label>
                            @if (Curso is null)
                            {
                                <div class="small text-muted">Elige primero un curso para ver sus temas.</div>
                            }
                            else if (!Curso.Temas.Any())
                            {
                                <div class="small text-muted">Este curso todavía no tiene temas.</div>
                            }
                            else
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var t in Curso.Temas)
                                    {
                                        var elegido = temasElegidos.Contains(t.IdTema);
                                        <button type="button" class="chip @(elegido ? "activo" : "")" aria-pressed="@(elegido ? "true" : "false")"
                                                @onclick="() => AlternarTema(t.IdTema)">
                                            @if (elegido)
                                            {
                                                <i class="bi bi-check-lg me-1"></i>
                                            }
                                            @t.Nombre
                                        </button>
                                    }
                                </div>
                                <div class="form-text">Elige uno o más temas que verán en la sesión.</div>
                            }
                        </div>

                        <div class="col-md-6">
                            <label for="fecha" class="form-label fw-semibold">Fecha</label>
                            <RadzenDatePicker TValue="DateOnly?" @bind-Value="fecha" Name="fecha" DateFormat="dd/MM/yyyy" Placeholder="dd/mm/aaaa"
                                              Min="@Hoy.ToDateTime(TimeOnly.MinValue)" Culture="@Peru" class="tp-fecha" />
                        </div>
                        <div class="col-md-6">
                            <label for="hora" class="form-label fw-semibold">Hora de inicio</label>
                            <select id="hora" class="form-select" @bind="hora">
                                <option value="">Elige una hora</option>
                                @foreach (var h in horarios)
                                {
                                    <option value="@Clave(h)" disabled="@HoraPasada(h)">@Hora12(h)</option>
                                }
                            </select>
                            @if (fecha == Hoy)
                            {
                                <div class="form-text">Para hoy solo puedes elegir horas que aún no pasaron.</div>
                            }
                        </div>
                    </div>

                    <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 mt-4">
                        @if (!EsValido)
                        {
                            <small class="text-muted me-auto">Falta elegir: @Faltan.</small>
                        }
                        <a class="btn btn-outline-secondary" href="/sesiones">Cancelar</a>
                        <button type="button" class="btn btn-primary" disabled="@(!EsValido || guardando)" @onclick="Registrar">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else
                            {
                                <i class="bi bi-calendar-check me-1"></i>
                            }
                            Registrar sesión
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card entrar" style="--i: 1;">
                <div class="card-body">
                    <h2 class="h5 mb-3"><i class="bi bi-card-list me-2 text-primary"></i>Resumen</h2>
                    <dl class="row datos mb-0">
                        <dt class="col-4">Estudiante</dt>
                        <dd class="col-8">@(NombreEstudiante == "" ? "—" : NombreEstudiante)</dd>
                        <dt class="col-4">Curso</dt>
                        <dd class="col-8">@(Curso?.Nombre ?? "—")</dd>
                        <dt class="col-4">Temas</dt>
                        <dd class="col-8">@(temasElegidos.Count == 0 ? "—" : string.Join(", ", TemasEnOrden))</dd>
                        <dt class="col-4">Inicio</dt>
                        <dd class="col-8">@InicioTexto</dd>
                        <dt class="col-4">Tarifa</dt>
                        <dd class="col-8">@(Curso is null ? "—" : TarifaTexto(Curso.Tarifa))</dd>
                        <dt class="col-4">Estado</dt>
                        <dd class="col-8 mb-0"><span class="badge text-bg-primary">Programada</span></dd>
                    </dl>
                </div>
            </div>
            <div class="nota small mt-3">
                <i class="bi bi-info-circle me-1 text-primary"></i>Cuando los dos registren su check-in, la sesión pasa a En curso.
                Si pasan 15 minutos sin ambos check-in, se cancela por inasistencia.
            </div>
        </div>
    </div>
}

@code {
    // Mientras no haya inicio de sesión, se usa la tutora de prueba del script: Ana Lucia Quispe Huaman (usuario 1).
    private const int TutorDePrueba = 1;

    private static readonly CultureInfo Peru = new("es-PE");

    // Inicios posibles: de 8:00 a. m. a 9:30 p. m., cada media hora
    private static readonly TimeOnly[] horarios =
        Enumerable.Range(0, 28).Select(i => new TimeOnly(8, 0).AddMinutes(30 * i)).ToArray();

    private readonly List<ToastMessage> avisos = [];
    private readonly HashSet<int> temasElegidos = [];

    // Cursos del tutor y estudiantes de la BD (GET /sesion/opciones)
    private OpcionesSesionRestDTO opciones = new();
    private bool cargando = true;
    private string? errorCarga;

    private string idEstudiante = "";
    private string idCurso = "";
    private DateOnly? fecha;
    private string hora = "";
    private bool guardando;
    private SesionRestDTO? registrada;   // la sesión que devolvió el REST al registrarla

    private int IdTutor => RolActual.Usuario?.IdUsuario ?? TutorDePrueba;
    private bool UsaTutorDePrueba => RolActual.Usuario is null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            opciones = await Rest.OpcionesAsync(IdTutor);
        }
        catch (Exception ex)
        {
            errorCarga = AcademicoRestService.MensajeDeError(ex);
        }
        finally
        {
            cargando = false;
        }
    }

    private static DateOnly Hoy => DateOnly.FromDateTime(DateTime.Today);

    private CursoSesionRestDTO? Curso => opciones.Cursos.FirstOrDefault(c => c.IdCurso.ToString() == idCurso);

    private string NombreEstudiante => opciones.Estudiantes.FirstOrDefault(e => e.IdUsuario.ToString() == idEstudiante)?.Nombre ?? "";

    private IEnumerable<string> TemasEnOrden =>
        Curso?.Temas.Where(t => temasElegidos.Contains(t.IdTema)).Select(t => t.Nombre) ?? [];

    private DateTime? Inicio =>
        fecha is { } f && TimeOnly.TryParseExact(hora, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var h)
            ? f.ToDateTime(h)
            : null;

    private string InicioTexto =>
        Inicio is { } i ? $"{i.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)} · {Hora12(TimeOnly.FromDateTime(i))}"
        : fecha is { } f ? f.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)
        : "—";

    private string Faltan
    {
        get
        {
            var faltan = new List<string>();
            if (idEstudiante == "") faltan.Add("estudiante");
            if (Curso is null) faltan.Add("curso");
            else if (temasElegidos.Count == 0) faltan.Add("al menos un tema");
            if (fecha is null) faltan.Add("fecha");
            if (hora == "") faltan.Add("hora");
            else if (Inicio is { } i && i <= DateTime.Now) faltan.Add("una fecha y hora que no hayan pasado");
            return string.Join(", ", faltan);
        }
    }

    private bool EsValido => Faltan.Length == 0;

    // Para hoy, las horas que ya pasaron no se pueden elegir
    private bool HoraPasada(TimeOnly h) => fecha == Hoy && h <= TimeOnly.FromDateTime(DateTime.Now);

    private static string Clave(TimeOnly h) => h.ToString("HH:mm", CultureInfo.InvariantCulture);

    private static string Hora12(TimeOnly h) =>
        $"{(h.Hour % 12 == 0 ? 12 : h.Hour % 12)}:{h.Minute:00} {(h.Hour < 12 ? "a. m." : "p. m.")}";

    private static string TarifaTexto(decimal? tarifa) => tarifa is decimal t ? $"S/ {t:0.00} por hora" : "sin tarifa registrada";

    private void AlCambiarCurso() => temasElegidos.Clear();

    private void AlternarTema(int idTema)
    {
        if (!temasElegidos.Remove(idTema)) temasElegidos.Add(idTema);
    }

    // POST /sesion. Las reglas (fecha futura, postulación aprobada, temas del curso...) las vuelve a validar el BL.
    private async Task Registrar()
    {
        if (guardando || Curso is null || Inicio is not DateTime inicio) return;
        guardando = true;
        try
        {
            var formulario = new RegistrarSesionFormulario
            {
                IdTutor = IdTutor,
                IdEstudiante = int.Parse(idEstudiante),
                IdCurso = Curso.IdCurso,
                IdsTemas = Curso.Temas.Where(t => temasElegidos.Contains(t.IdTema)).Select(t => t.IdTema).ToList(),
                FechaHoraInicio = inicio.ToString("yyyy-MM-dd'T'HH:mm:ss", CultureInfo.InvariantCulture),
            };
            registrada = await Rest.RegistrarAsync(formulario);
            avisos.Add(new ToastMessage
            {
                Type = ToastType.Success,
                Title = "Sesión registrada",
                Message = $"La sesión N.º {registrada.IdSesion} quedó Programada.",
            });
        }
        catch (Exception ex)
        {
            avisos.Add(new ToastMessage
            {
                Type = ToastType.Danger,
                Title = "No se pudo registrar la sesión",
                Message = AcademicoRestService.MensajeDeError(ex),
            });
        }
        finally
        {
            guardando = false;
        }
    }

    private void RegistrarOtra()
    {
        idEstudiante = "";
        idCurso = "";
        temasElegidos.Clear();
        fecha = null;
        hora = "";
        registrada = null;
    }
}
