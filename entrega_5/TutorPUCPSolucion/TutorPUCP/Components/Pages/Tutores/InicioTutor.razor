@page "/tutor"
@inject RolActual RolActual

<PageTitle>Inicio Tutor - TutorPUCP</PageTitle>

<EncabezadoPagina Icono="bi-mortarboard-fill" Titulo="Panel del Tutor"
                  Subtitulo="@($"Hola, {RolActual.PrimerNombre}. Gestiona tus cursos, tarifas y solicitudes académicas.")">
    <a href="/tutor/postular" class="btn btn-primary"><i class="bi bi-plus-lg"></i>Postular a nuevo curso</a>
</EncabezadoPagina>

@* Indicadores *@
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-4">
        <TarjetaDato Icono="bi-star" Valor="@calificacionPromedio.ToString("0.0")" Sufijo="/ 5.0"
                     Etiqueta="Calificación promedio" Detalle="@($"Basado en {totalSesiones} tutorías")" />
    </div>
    <div class="col-sm-6 col-lg-4">
        <TarjetaDato Icono="bi-check-circle" Valor="@totalSesiones.ToString()"
                     Etiqueta="Sesiones completadas" Detalle="Horas dictadas este ciclo" />
    </div>
    <div class="col-sm-12 col-lg-4">
        <TarjetaDato Icono="bi-journal-check" Valor="@cursosHabilitados.ToString()"
                     Etiqueta="Cursos habilitados" Detalle="Con postulación aprobada" />
    </div>
</div>

@* Accesos directos *@
<h2 class="seccion-titulo">Gestión de Tutor</h2>
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="acceso">
                <span class="kpi-icono" aria-hidden="true"><i class="bi bi-file-earmark-text"></i></span>
                <div class="d-flex flex-column h-100">
                    <h3>Mis Postulaciones a Cursos</h3>
                    <p>Revisa el estado de aprobación de tus certificados de notas enviados a coordinación académica.</p>
                    <a href="/tutor/postulaciones" class="btn btn-outline-primary btn-sm align-self-start mt-auto">
                        Consultar historial de postulaciones <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="acceso">
                <span class="kpi-icono" aria-hidden="true"><i class="bi bi-cash-coin"></i></span>
                <div class="d-flex flex-column h-100">
                    <h3>Mis Tarifas por Hora</h3>
                    <p>Establece y modifica el costo en soles por hora de clase para los cursos en los que fuiste aprobado.</p>
                    <a href="/tutor/tarifas" class="btn btn-outline-primary btn-sm align-self-start mt-auto">
                        Configurar mis tarifas <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@* Próximas sesiones *@
<div class="card mb-4">
    <div class="card-header cabecera">
        <h2 class="card-titulo">Próximas Sesiones Programadas</h2>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle tabla-tp">
            <thead class="table-primary">
                <tr>
                    <th>Estudiante</th>
                    <th>Curso</th>
                    <th>Fecha y Hora</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (listaSesionesSimuladas != null)
                {
                    @foreach (var sesion in listaSesionesSimuladas)
                    {
                        <tr>
                            <td class="fw-semibold">@sesion.Estudiante</td>
                            <td>@sesion.Curso</td>
                            <td class="text-nowrap">@sesion.Fecha</td>
                            <td><EstadoBadge Estado="@sesion.Estado" /></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {

    // Lista de prueba 
    private List<SesionPrueba> listaSesionesSimuladas = new()
    {
        new SesionPrueba { Estudiante = "Lucía Fernández P.", Curso = "1INF30 - Programación 3", Fecha = "28/10/2026 - 15:00 hrs", Estado = "PROGRAMADA" },
        new SesionPrueba { Estudiante = "Mateo Silva R.", Curso = "1INF01 - Algoritmia", Fecha = "30/10/2026 - 17:30 hrs", Estado = "PROGRAMADA" }
    };
    public class SesionPrueba
    {
        public string Estudiante { get; set; }
        public string Curso { get; set; }
        public string Fecha { get; set; }
        public string Estado { get; set; }
    }

    // Datos simulados 
    private double calificacionPromedio = 4.9;
    private int totalSesiones = 16;
    private int cursosHabilitados = 2;
}
