@page "/tutor"
@inject RolActual RolActual

<PageTitle>Inicio Tutor - TutorPUCP</PageTitle>
@* =============================================================================
     ENCABEZADO Y BOTÓN DE ACCIÓN RÁPIDA
   - "d-flex justify-content-between": Título a la izquierda, botón a la derecha.
   - Usamos btn-primary (azul uniforme de la aplicación).
   ============================================================================= *@
<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="text-primary fw-bold mb-1">Panel del Tutor</h2>
        <p class="text-muted mb-0">Hola, @RolActual.PrimerNombre. Gestiona tus cursos, tarifas y solicitudes académicas.</p>
    </div>
    <a href="/tutor/postular" class="btn btn-primary shadow-sm">
        + Postular a nuevo curso
    </a>
</div>
@* =============================================================================
     TARJETAS DE MÉTRICAS (KPIs)
   - "card shadow-sm border-0": Tarjeta blanca limpia con sombra suave y sin bordes toscos.
   - Usamos los colores semánticos: warning (amarillo), primary (azul) y success (verde).
   ============================================================================= *@
<div class="row g-3 mb-4">
    @* Calificación Promedio *@
    <div class="col-md-4">
        <div class="card shadow-sm border-0 text-center p-3 h-100 bg-light">
            <span class="text-muted small fw-semibold">CALIFICACIÓN PROMEDIO</span>
            <h3 class="text-warning fw-bold my-2">
                 @calificacionPromedio.ToString("0.0") <span class="fs-6 text-muted fw-normal">/ 5.0</span>
            </h3>
            <span class="text-muted small">Basado en @totalSesiones tutorías</span>
        </div>
    </div>
    @* Sesiones Realizadas *@
    <div class="col-md-4">
        <div class="card shadow-sm border-0 text-center p-3 h-100 bg-light">
            <span class="text-muted small fw-semibold">SESIONES COMPLETADAS</span>
            <h3 class="text-primary fw-bold my-2">@totalSesiones</h3>
            <span class="text-muted small">Horas dictadas este ciclo</span>
        </div>
    </div>
    @*  Cursos Aprobados *@
    <div class="col-md-4">
        <div class="card shadow-sm border-0 text-center p-3 h-100 bg-light">
            <span class="text-muted small fw-semibold">CURSOS HABILITADOS</span>
            <h3 class="text-success fw-bold my-2">@cursosHabilitados</h3>
            <span class="text-muted small">Con postulación aprobada</span>
        </div>
    </div>
</div>
@* =============================================================================
   ACCESOS DIRECTOS 
   ============================================================================= *@
<h5 class="fw-bold text-secondary mb-3">Gestión de Tutor</h5>
<div class="row g-3 mb-4">
    @* Mis Postulaciones *@
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex flex-column justify-content-between p-4">
                <div>
                    <h5 class="card-title fw-bold text-dark"> Mis Postulaciones a Cursos</h5>
                    <p class="card-text text-muted">
                        Revisa el estado de aprobación de tus certificados de notas enviados a coordinación académica.
                    </p>
                </div>
                <a href="/tutor/postulaciones" class="btn btn-outline-primary mt-3">
                    Consultar historial de postulaciones →
                </a>
            </div>
        </div>
    </div>
    @* Mis Tarifas *@
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex flex-column justify-content-between p-4">
                <div>
                    <h5 class="card-title fw-bold text-dark"> Mis Tarifas por Hora</h5>
                    <p class="card-text text-muted">
                        Establece y modifica el costo en soles por hora de clase para los cursos en los que fuiste aprobado.
                    </p>
                </div>
                <a href="/tutor/tarifas" class="btn btn-outline-success mt-3">
                    Configurar mis tarifas →
                </a>
            </div>
        </div>
    </div>
</div>
@* =============================================================================
   PRÓXIMAS SESIONES (TABLA DE MOCKUP)
   ============================================================================= *@
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-0">
        <h5 class="fw-bold mb-0 text-dark"> Próximas Sesiones Programadas</h5>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Estudiante</th>
                    <th>Curso</th>
                    <th>Fecha y Hora</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>

                @if (listaSesionesSimuladas != null)
                {
                    @foreach (var sesion in listaSesionesSimuladas)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">@sesion.Estudiante</td>
                            <td>@sesion.Curso</td>
                            <td>@sesion.Fecha</td>
                            <td><span class="badge bg-primary">@sesion.Estado</span></td>
                        </tr>
                    }
                }

                
            </tbody>
        </table>
    </div>
</div>
@* =============================================================================
   LÓGICA EN C# 
   ============================================================================= *@
@code {

    // Lista de prueba 
    private List<SesionPrueba> listaSesionesSimuladas = new()
    {
        new SesionPrueba { Estudiante = "Lucía Fernández P.", Curso = "1INF30 - Programación 3", Fecha = "28/10/2026 - 15:00 hrs", Estado = "PROGRAMADA" },
        new SesionPrueba { Estudiante = "Mateo Silva R.", Curso = "1INF01 - Algoritmia", Fecha = "30/10/2026 - 17:30 hrs", Estado = "PROGRAMADA" }
    };
    public class SesionPrueba
    {
        public string Estudiante { get; set; }
        public string Curso { get; set; }
        public string Fecha { get; set; }
        public string Estado { get; set; }
    }

    // Datos simulados 
    private double calificacionPromedio = 4.9;
    private int totalSesiones = 16;
    private int cursosHabilitados = 2;
}