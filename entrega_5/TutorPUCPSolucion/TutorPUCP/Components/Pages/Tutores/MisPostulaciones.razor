@page "/tutor/postulaciones"
@using TutorPUCP.Servicios
@inject AcademicoApi Api
@inject RolActual EstadoSesion

<PageTitle>Mis postulaciones</PageTitle>

@* =============================================================================
   ENCABEZADO Y BOTÓN DE ACCIÓN
   ============================================================================= *@
<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="text-primary fw-bold mb-1">Mis Postulaciones a Cursos</h2>
        <p class="text-muted mb-0">Consulta el historial y el estado de acreditación de tus solicitudes académicas.</p>
    </div>
    <a href="/tutor/postular" class="btn btn-primary shadow-sm">
        + Nueva Postulación
    </a>
</div>

@* Alerta de error si falla la comunicación con REST *@
@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-warning alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

@* =============================================================================
   TARJETAS DE RESUMEN RÁPIDO
   ============================================================================= *@
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 p-3 bg-light text-center">
            <span class="text-muted small fw-semibold">TOTAL POSTULACIONES</span>
            <h4 class="text-dark fw-bold mb-0">@listaPostulaciones.Count</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 p-3 bg-light text-center">
            <span class="text-muted small fw-semibold">APROBADAS</span>
            <h4 class="text-success fw-bold mb-0">
                @listaPostulaciones.Count(p => p.Estado == "APROBADA")
            </h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 p-3 bg-light text-center">
            <span class="text-muted small fw-semibold">EN REVISIÓN</span>
            <h4 class="text-warning fw-bold mb-0">
                @listaPostulaciones.Count(p => p.Estado == "PENDIENTE")
            </h4>
        </div>
    </div>
</div>

@* =============================================================================
   TABLA DE POSTULACIONES 
   ============================================================================= *@
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-0">
        <h5 class="fw-bold mb-0 text-dark">Historial de Solicitudes</h5>
    </div>
    <div class="card-body p-0">
        @if (cargando)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2 mb-0">Cargando tus postulaciones desde el servidor...</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Curso</th>
                            <th>Fecha de Envío</th>
                            <th>Certificado PDF</th>
                            <th>Estado</th>
                            <th>Resolución / Observación del Administrador</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (listaPostulaciones != null && listaPostulaciones.Count > 0)
                        {
                            @foreach (var post in listaPostulaciones)
                            {
                                <tr>
                                    @* Nombre y código del curso *@
                                    <td class="ps-3 fw-semibold">@post.CursoCodigo - @post.CursoNombre</td>
                                    @* Fecha en que se envió *@
                                    <td class="text-muted">@(string.IsNullOrEmpty(post.FechaPostulacion) ? "Reciente" : post.FechaPostulacion)</td>
                                    @* Archivo adjunto con ícono PDF *@
                                    <td>
                                        <span class="badge bg-secondary text-white">
                                            <i class="bi bi-file-earmark-pdf"></i> @post.ArchivoCertificadoUrl
                                        </span>
                                    </td>
                                    @* Estado con insignia de color dinámico *@
                                    <td>
                                        <span class="badge @ObtenerColorBadge(post.Estado)">
                                            @post.Estado
                                        </span>
                                    </td>
                                    @* Dictamen del administrador *@
                                    <td class="small @(post.Estado == "RECHAZADA" ? "text-danger" : "text-muted")">
                                        @(string.IsNullOrEmpty(post.Resolucion) ? "En espera de revisión por el administrador." : post.Resolucion)
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    No tienes ninguna postulación registrada todavía.
                                    <a href="/tutor/postular" class="alert-link ms-1">¡Postula a tu primer curso aquí!</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* Botón para regresar al panel *@
<div class="mt-3">
    <a href="/tutor" class="btn btn-outline-secondary btn-sm">
        ← Volver al Panel del Tutor
    </a>
</div>

@* =============================================================================
   LÓGICA Y MODELO EN C# (RF004)
   ============================================================================= *@
@code {
    private bool cargando = true;
    private string? mensajeError = null;

    // Lista de postulaciones obtenida en tiempo real desde MySQL mediante REST
    private List<PostulacionDto> listaPostulaciones = new();

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        int idTutorActual = EstadoSesion.Usuario?.IdUsuario ?? 1;

        var (postulaciones, error) = await Api.ListarPostulacionesPorTutorAsync(idTutorActual);

        if (error != null)
        {
            mensajeError = error;
            // Datos iniciales de cortesía en caso de no conectar a BD aún
            listaPostulaciones = new()
            {
                new PostulacionDto(1, 1, "1INF30", "Programación 3", "certificado_p3.pdf", "APROBADA", "2026-10-15", "2026-10-16", "Aprobado por coordinación académica."),
                new PostulacionDto(2, 2, "1INF01", "Algoritmia", "cert_algoritmia.pdf", "PENDIENTE", "2026-10-22", null, "En evaluación.")
            };
        }
        else if (postulaciones != null)
        {
            listaPostulaciones = postulaciones;
        }

        cargando = false;
    }

    private string ObtenerColorBadge(string estado)
    {
        return estado switch
        {
            "APROBADA" => "bg-success",           // Verde
            "PENDIENTE" => "bg-warning text-dark", // Amarillo
            "RECHAZADA" => "bg-danger",           // Rojo
            _ => "bg-secondary"
        };
    }
}
