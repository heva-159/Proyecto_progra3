@page "/tutor/postulaciones"
@using TutorPUCP.Servicios
@inject AcademicoApi Api
@inject RolActual EstadoSesion

<PageTitle>Mis postulaciones</PageTitle>

<EncabezadoPagina Icono="bi-file-earmark-text-fill" Titulo="Mis Postulaciones a Cursos"
                  Subtitulo="Consulta el historial y el estado de acreditación de tus solicitudes académicas.">
    <a href="/tutor" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i>Volver al Panel del Tutor</a>
    <a href="/tutor/postular" class="btn btn-primary"><i class="bi bi-plus-lg"></i>Nueva Postulación</a>
</EncabezadoPagina>

@* Alerta de error si falla la comunicación con REST *@
@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-warning alert-dismissible fade show d-flex gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i><div>@mensajeError</div>
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

@* Resumen rápido *@
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <TarjetaDato Icono="bi-collection" Valor="@listaPostulaciones.Count.ToString()" Etiqueta="Total postulaciones" />
    </div>
    <div class="col-sm-4">
        <TarjetaDato Icono="bi-check-circle" Valor="@listaPostulaciones.Count(p => p.Estado == "APROBADA").ToString()" Etiqueta="Aprobadas" />
    </div>
    <div class="col-sm-4">
        <TarjetaDato Icono="bi-hourglass-split" Valor="@listaPostulaciones.Count(p => p.Estado == "PENDIENTE").ToString()" Etiqueta="En revisión" />
    </div>
</div>

@* Tabla de postulaciones *@
<div class="card mb-4">
    <div class="card-header cabecera">
        <h2 class="card-titulo">Historial de Solicitudes</h2>
    </div>
    @if (cargando)
    {
        <div class="estado-vacio">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="small mt-2">Cargando tus postulaciones desde el servidor...</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle tabla-tp">
                <thead class="table-primary">
                    <tr>
                        <th>Curso</th>
                        <th>Fecha de Envío</th>
                        <th>Certificado PDF</th>
                        <th>Estado</th>
                        <th>Resolución / Observación del Administrador</th>
                    </tr>
                </thead>
                <tbody>
                    @if (listaPostulaciones != null && listaPostulaciones.Count > 0)
                    {
                        @foreach (var post in listaPostulaciones)
                        {
                            <tr>
                                <td class="fw-semibold">@post.CursoCodigo - @post.CursoNombre</td>
                                <td class="text-muted text-nowrap">@(string.IsNullOrEmpty(post.FechaPostulacion) ? "Reciente" : post.FechaPostulacion)</td>
                                <td>
                                    <span class="etiqueta"><i class="bi bi-file-earmark-pdf"></i>@post.ArchivoCertificadoUrl</span>
                                </td>
                                <td><EstadoBadge Estado="@post.Estado" /></td>
                                <td class="small @(post.Estado == "RECHAZADA" ? "text-danger" : "text-muted")">
                                    @(string.IsNullOrEmpty(post.Resolucion) ? "En espera de revisión por el administrador." : post.Resolucion)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="p-0">
                                <div class="estado-vacio">
                                    <i class="bi bi-inbox"></i>
                                    <div class="fw-semibold">No tienes ninguna postulación registrada todavía.</div>
                                    <a href="/tutor/postular" class="small">¡Postula a tu primer curso aquí!</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private bool cargando = true;
    private string? mensajeError = null;

    // Lista de postulaciones obtenida en tiempo real desde MySQL mediante REST
    private List<PostulacionDto> listaPostulaciones = new();

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        int idTutorActual = EstadoSesion.Usuario?.IdUsuario ?? 1;

        var (postulaciones, error) = await Api.ListarPostulacionesPorTutorAsync(idTutorActual);

        if (error != null)
        {
            mensajeError = error;
            // Datos iniciales de cortesía en caso de no conectar a BD aún
            listaPostulaciones = new()
            {
                new PostulacionDto(1, 1, "1INF30", "Programación 3", "certificado_p3.pdf", "APROBADA", "2026-10-15", "2026-10-16", "Aprobado por coordinación académica."),
                new PostulacionDto(2, 2, "1INF01", "Algoritmia", "cert_algoritmia.pdf", "PENDIENTE", "2026-10-22", null, "En evaluación.")
            };
        }
        else if (postulaciones != null)
        {
            listaPostulaciones = postulaciones;
        }

        cargando = false;
    }

    private string ObtenerColorBadge(string estado)
    {
        return estado switch
        {
            "APROBADA" => "bg-success",           // Verde
            "PENDIENTE" => "bg-warning text-dark", // Amarillo
            "RECHAZADA" => "bg-danger",           // Rojo
            _ => "bg-secondary"
        };
    }
}
