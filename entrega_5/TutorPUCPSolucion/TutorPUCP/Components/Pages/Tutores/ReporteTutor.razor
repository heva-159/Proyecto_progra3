@page "/tutor/reportes"
@inject RolActual RolActual

@* Requisito: RF017 (reporte de tutorías del tutor por rango de fechas) *@

<PageTitle>Reporte de tutorías</PageTitle>

<EncabezadoPagina Icono="bi-file-earmark-bar-graph-fill" Titulo="Reporte de tutorías"
                  Subtitulo="Descarga en PDF las tutorías que dictaste dentro de un rango de fechas, con su estado y calificación." />

@if (RolActual.Usuario is null)
{
    <div class="alert alert-warning d-flex gap-2"><i class="bi bi-person-lock"></i><div>Inicia sesión como tutor para descargar tu reporte.</div></div>
}
else if (!RolActual.TieneRol(RolActual.Tutor))
{
    <div class="alert alert-warning d-flex gap-2"><i class="bi bi-person-lock"></i><div>Tu cuenta no tiene el perfil de tutor.</div></div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            @* GET normal (sin Blazor): el navegador descarga el PDF que devuelve /reportes/tutor/descargar *@
            <form method="get" action="reportes/tutor/descargar" class="card tarjeta-form" data-enhance="false">
                <input type="hidden" name="idTutor" value="@RolActual.Usuario.IdUsuario" />
                <input type="hidden" name="desde" value="@Iso(desde)" />
                <input type="hidden" name="hasta" value="@Iso(hasta)" />
                <div class="card-header cabecera">
                    <h2 class="card-titulo"><i class="bi bi-funnel me-2 text-primary"></i>Rango de fechas</h2>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label for="desde" class="form-label">Desde</label>
                            <RadzenDatePicker TValue="DateOnly" @bind-Value="desde" DateFormat="dd/MM/yyyy" Max="@hasta.ToDateTime(TimeOnly.MinValue)" Culture="@Peru" class="tp-fecha" />
                        </div>
                        <div class="col-sm-6">
                            <label for="hasta" class="form-label">Hasta</label>
                            <RadzenDatePicker TValue="DateOnly" @bind-Value="hasta" DateFormat="dd/MM/yyyy" Min="@desde.ToDateTime(TimeOnly.MinValue)" Culture="@Peru" class="tp-fecha" />
                        </div>
                    </div>
                    @if (desde > hasta)
                    {
                        <div class="alert alert-warning py-2 small mt-3 mb-0"><i class="bi bi-exclamation-triangle me-1"></i>La fecha «Desde» no puede ser posterior a «Hasta».</div>
                    }
                    <div class="acciones-form">
                        <small class="text-muted me-auto">Periodo: @desde.ToString("dd/MM/yyyy", Peru) al @hasta.ToString("dd/MM/yyyy", Peru)</small>
                        <button type="submit" class="btn btn-primary px-4" disabled="@(desde > hasta)"><i class="bi bi-filetype-pdf me-1"></i>Descargar PDF</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="col-lg-4">
            <div class="nota aviso-info" role="note">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    <strong>¿Qué incluye el reporte?</strong><br />
                    Las tutorías que dictaste entre las dos fechas elegidas, con su estado y su calificación.
                    Por defecto se propone desde el primer día del mes hasta hoy.
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo Peru = new("es-PE");

    // por defecto, del primer día del mes hasta hoy
    private DateOnly desde = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateOnly hasta = DateOnly.FromDateTime(DateTime.Today);

    // Java recibe las fechas como yyyy-MM-dd
    private static string Iso(DateOnly fecha) => fecha.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
}
