@page "/admin/reclamos/resolver"
@page "/admin/reclamos/resolver/{Id:int}"
@inject NavigationManager Navigation
@inject RolActual RolActual
@inject ReclamosApi ReclamosApi

@* Requisito: RF016 (consultar y resolver reclamos) *@

<PageTitle>Resolver reclamo</PageTitle>

<Toasts class="p-3" Messages="avisos" AutoHide="true" Delay="4500" Placement="ToastsPlacement.TopRight" />

<a href="/admin/reclamos" class="small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Volver a reclamos pendientes</a>

@if (cargando)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else if (reclamo is null)
{
    <div class="alert alert-danger d-flex gap-2 mt-3"><i class="bi bi-exclamation-triangle"></i><div>@(error ?? "No se encontró el reclamo.")</div></div>
}
else
{
<div class="titulo-pagina mt-2">
    <div class="d-flex align-items-center gap-3">
        <span class="icono-titulo" style="background:#fee2e2;color:#dc2626;"><i class="bi bi-flag-fill"></i></span>
        <div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="h3 mb-0">@(Pendiente ? "Resolver" : "Reclamo") N.º @reclamo.IdReclamo</h1>
                <span class="badge @ClaseEstado" @key="reclamo.Estado" style="animation: tpAparecer .4s ease both;">@reclamo.EstadoTexto</span>
            </div>
            <p>Registrado el @reclamo.Registrado.ToString("dd/MM/yyyy") · @HaceCuanto</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card mb-4 entrar" style="--i: 0;">
            <div class="card-body">
                <h2 class="h5 mb-3"><i class="bi bi-chat-square-text me-2 text-primary"></i>Reclamo</h2>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <Avatar Nombre="@(reclamo.NombreReclamante ?? "?")" />
                    <div class="lh-sm">
                        <div class="fw-bold">@reclamo.NombreReclamante</div>
                        <small class="text-muted">Reclama como <b>@reclamo.Rol</b></small>
                    </div>
                </div>
                <div class="p-3 rounded-4 caja-suave">
                    <i class="bi bi-quote text-primary fs-4"></i>
                    @reclamo.Motivo
                </div>
            </div>
        </div>

        <div class="card entrar" style="--i: 1;">
            <div class="card-body">
                <h2 class="h5 mb-3"><i class="bi bi-calendar-check me-2 text-primary"></i>Sesión N.º @reclamo.IdSesion</h2>
                <dl class="row datos mb-0">
                    <dt class="col-5">Curso</dt>
                    <dd class="col-7">@reclamo.Curso</dd>
                    <dt class="col-5">Tutor</dt>
                    <dd class="col-7">@reclamo.NombreTutor</dd>
                    <dt class="col-5">Estudiante</dt>
                    <dd class="col-7">@reclamo.NombreEstudiante</dd>
                    <dt class="col-5">Inicio programado</dt>
                    <dd class="col-7 mb-0">@(reclamo.Sesion == DateTime.MinValue ? "—" : reclamo.Sesion.ToString("dd/MM/yyyy, h:mm tt"))</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100 entrar" style="--i: 2;">
            <div class="card-body">
                @if (Pendiente)
                {
                    <Pasos Etapas="Etapas" Actual="@(decision == "" ? 1 : 2)" />

                    <h2 class="h5 mb-3">Resolución</h2>

                    @if (RolActual.Administrador is null)
                    {
                        <div class="alert alert-warning d-flex gap-2 small"><i class="bi bi-person-lock"></i><div>Inicia sesión como administrador para resolver reclamos.</div></div>
                    }

                    <label class="form-label fw-semibold">Decisión</label>
                    <div class="d-grid gap-2 mb-3">
                        <button type="button" class="opcion-tarjeta aprobar @(decision == "Aprobado" ? "elegida" : "")" @onclick="@(() => decision = "Aprobado")">
                            <span class="opcion-marca"><i class="bi bi-check"></i></span>
                            <span class="lh-sm"><b class="text-success"><i class="bi bi-hand-thumbs-up me-1"></i>Aprobar reclamo</b><br /><small class="text-muted">El reclamo procede</small></span>
                        </button>
                        <button type="button" class="opcion-tarjeta rechazar @(decision == "Rechazado" ? "elegida" : "")" @onclick="@(() => decision = "Rechazado")">
                            <span class="opcion-marca"><i class="bi bi-check"></i></span>
                            <span class="lh-sm"><b class="text-danger"><i class="bi bi-hand-thumbs-down me-1"></i>Rechazar reclamo</b><br /><small class="text-muted">El reclamo no procede</small></span>
                        </button>
                    </div>

                    <label for="resolucion" class="form-label fw-semibold">Resolución</label>
                    <textarea id="resolucion" class="form-control" rows="5" maxlength="255"
                              placeholder="Explica la decisión que se comunicará al reclamante."
                              @bind="resolucion" @bind:event="oninput"></textarea>
                    <div class="d-flex justify-content-between mt-1 mb-3">
                        <small class="text-muted">Obligatoria.</small>
                        <small class="contador-caracteres @(resolucion.Length > 220 ? "cerca" : "")">@resolucion.Length / 255</small>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-secondary" href="/admin/reclamos">Cancelar</a>
                        <button type="button" class="btn btn-primary"
                                disabled="@(decision == "" || string.IsNullOrWhiteSpace(resolucion) || RolActual.Administrador is null)"
                                @onclick="AbrirConfirmar">
                            <i class="bi bi-save me-1"></i>Guardar resolución
                        </button>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 paso-panel">
                        <div class="exito-icono @(reclamo.EstadoTexto == "Rechazado" ? "rechazo" : "")">
                            <i class="bi @(reclamo.EstadoTexto == "Aprobado" ? "bi-check-lg" : "bi-x-lg")"></i>
                        </div>
                        <h2 class="h4">Reclamo @reclamo.EstadoTexto.ToLower()</h2>
                        <p class="text-muted">
                            Resuelto por @(reclamo.NombreAdministrador ?? "el administrador")
                            @if (reclamo.FechaResolucion is not null)
                            {
                                <span>el @reclamo.Resuelto.ToString("dd/MM/yyyy")</span>
                            }.
                        </p>
                        <div class="text-start p-3 rounded-4 mb-4 caja-suave">
                            <div class="small text-uppercase text-muted fw-bold mb-1">Resolución</div>
                            @reclamo.Resolucion
                        </div>
                        <a class="btn btn-primary" href="/admin/reclamos"><i class="bi bi-arrow-left me-1"></i>Volver a pendientes</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
}

<Modal @ref="confirmar" Title="Confirmar resolución" IsVerticallyCentered="true">
    <BodyTemplate>
        <Pasos Etapas="Etapas" Actual="2" />
        <p class="mb-2">Vas a <b class="@(decision == "Aprobado" ? "text-success" : "text-danger")">@(decision == "Aprobado" ? "aprobar" : "rechazar")</b> el reclamo N.º @reclamo?.IdReclamo de @reclamo?.NombreReclamante.</p>
        <div class="p-3 rounded-4 small caja-suave">@resolucion</div>
        @if (errorGuardar is not null)
        {
            <div class="alert alert-danger d-flex gap-2 small mt-3 mb-0 alerta-sacudir"><i class="bi bi-exclamation-triangle"></i><div>@errorGuardar</div></div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => confirmar.HideAsync()">Revisar otra vez</button>
        <button type="button" class="btn @(decision == "Aprobado" ? "btn-success" : "btn-danger")" disabled="@guardando" @onclick="Guardar">
            @if (guardando)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            Sí, guardar
        </button>
    </FooterTemplate>
</Modal>

@code {
    [Parameter] public int? Id { get; set; }

    private static readonly string[] Etapas = ["Revisar", "Decidir", "Confirmar"];

    private Modal confirmar = default!;
    private readonly List<ToastMessage> avisos = [];

    private ReclamoDto? reclamo;
    private bool cargando = true;
    private string? error;

    private string decision = "";
    private string resolucion = "";
    private bool guardando;
    private string? errorGuardar;

    private bool Pendiente => reclamo?.Estado == "PENDIENTE";

    private string HaceCuanto
    {
        get
        {
            var dias = (DateTime.Today - reclamo!.Registrado.Date).Days;
            return dias <= 0 ? "hoy" : dias == 1 ? "hace 1 día" : $"hace {dias} días";
        }
    }

    private string ClaseEstado => reclamo?.EstadoTexto switch
    {
        "Aprobado" => "text-bg-success",
        "Rechazado" => "text-bg-danger",
        _ => "text-bg-warning",
    };

    protected override async Task OnInitializedAsync()
    {
        // Sin número de reclamo se vuelve a la lista de pendientes.
        if (Id is null) { Navigation.NavigateTo("/admin/reclamos"); return; }

        var (encontrado, fallo) = await ReclamosApi.ObtenerAsync(Id.Value);
        reclamo = encontrado;
        error = fallo;
        cargando = false;
    }

    private async Task AbrirConfirmar()
    {
        errorGuardar = null;
        await confirmar.ShowAsync();
    }

    private async Task Guardar()
    {
        guardando = true;
        errorGuardar = null;
        var (resuelto, fallo) = await ReclamosApi.ResolverAsync(reclamo!.IdReclamo, RolActual.Administrador!.IdAdministrador,
            decision == "Aprobado", resolucion.Trim());
        guardando = false;

        if (fallo is not null) { errorGuardar = fallo; return; }

        await confirmar.HideAsync();
        reclamo = resuelto;
        avisos.Add(new ToastMessage
        {
            Type = decision == "Aprobado" ? ToastType.Success : ToastType.Danger,
            Title = $"Reclamo N.º {reclamo!.IdReclamo} {decision.ToLower()}",
            Message = $"{reclamo.NombreReclamante} verá la resolución en «Mis reclamos».",
        });
    }
}
