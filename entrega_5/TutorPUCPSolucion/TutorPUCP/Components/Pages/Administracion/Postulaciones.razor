@page "/admin/postulaciones"
@inject AcademicoRestService Rest

@* Requisito: RF005. Los datos vienen de la BD a través del servicio REST (GestorAcademicoRecurso). *@

<PageTitle>Postulaciones</PageTitle>

<div class="titulo-pagina">
    <div class="d-flex align-items-center gap-3">
        <span class="icono-titulo" style="background:#fef3c7;color:#b45309;"><i class="bi bi-person-check-fill"></i></span>
        <div>
            <h1 class="h3">Postulaciones</h1>
            <p>Revisa el certificado de notas de cada tutor y aprueba o rechaza su postulación al curso.</p>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4 entrar" style="--i: 0;">
        <div class="card kpi h-100"><div class="card-body d-flex align-items-center gap-3">
            <span class="kpi-icono" style="background:#fef3c7;color:#b45309;"><i class="bi bi-hourglass-split"></i></span>
            <div><div class="kpi-valor">@Contar("Pendiente")</div><div class="small text-muted">Por revisar</div></div>
        </div></div>
    </div>
    <div class="col-sm-4 entrar" style="--i: 1;">
        <div class="card kpi h-100"><div class="card-body d-flex align-items-center gap-3">
            <span class="kpi-icono" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-check2-circle"></i></span>
            <div><div class="kpi-valor">@Contar("Aprobada")</div><div class="small text-muted">Aprobadas</div></div>
        </div></div>
    </div>
    <div class="col-sm-4 entrar" style="--i: 2;">
        <div class="card kpi h-100"><div class="card-body d-flex align-items-center gap-3">
            <span class="kpi-icono" style="background:#fee2e2;color:#dc2626;"><i class="bi bi-x-circle"></i></span>
            <div><div class="kpi-valor">@Contar("Rechazada")</div><div class="small text-muted">Rechazadas</div></div>
        </div></div>
    </div>
</div>

<div class="card">
    <div class="card-header py-3">
        <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <div class="position-relative flex-grow-1" style="max-width: 340px;">
                <i class="bi bi-search position-absolute text-muted" style="left: .8rem; top: 50%; transform: translateY(-50%);"></i>
                <input type="text" class="form-control ps-5" placeholder="Tutor, código o curso" aria-label="Buscar"
                       @bind="busqueda" @bind:event="oninput" />
            </div>
            <div class="segmento" role="group" aria-label="Estado de la postulación">
                @foreach (var e in new[] { "Pendientes", "Aprobadas", "Rechazadas", "Todas" })
                {
                    <button type="button" class="@(filtro == e ? "activo" : "")" @onclick="() => filtro = e">@e</button>
                }
            </div>
        </div>
    </div>

    @if (cargando)
    {
        <div class="estado-vacio">
            <div class="spinner-border text-primary mb-2" role="status"></div>
            <div class="fw-semibold">Cargando postulaciones...</div>
        </div>
    }
    else if (errorCarga is not null)
    {
        <div class="estado-vacio">
            <i class="bi bi-wifi-off"></i>
            <div class="fw-semibold">No se pudieron cargar las postulaciones</div>
            <div class="small">@errorCarga</div>
        </div>
    }
    else if (Filtradas.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th class="ps-3">Tutor</th>
                        <th>Curso</th>
                        <th>Fecha</th>
                        <th>Certificado</th>
                        <th>Estado</th>
                        <th class="text-end pe-3">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var i = 0; }
                    @foreach (var p in Filtradas)
                    {
                        <tr class="entrar" style="--i: @(i++);" @key="p.IdPostulacion">
                            <td class="ps-3">
                                <div class="d-flex align-items-center gap-2">
                                    <Avatar Nombre="@p.Tutor" Tamano="sm" />
                                    <div class="lh-sm">
                                        <div class="fw-semibold">@p.Tutor</div>
                                        <small class="text-muted">Código @p.CodigoPucp</small>
                                    </div>
                                </div>
                            </td>
                            <td><div class="fw-semibold">@p.Curso</div><small class="text-muted">@p.CodigoCurso</small></td>
                            <td>@p.FechaPostulacionTexto</td>
                            <td class="text-nowrap"><i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i><small>@p.NombreCertificado</small></td>
                            <td><span class="badge @ClaseEstado(p.EstadoTexto)">@p.EstadoTexto</span></td>
                            <td class="text-end pe-3 text-nowrap">
                                @if (p.EsPendiente)
                                {
                                    <a class="btn btn-primary btn-sm" href="@($"/admin/postulaciones/revisar?id={p.IdPostulacion}")">
                                        <i class="bi bi-clipboard-check me-1"></i>Revisar
                                    </a>
                                }
                                else
                                {
                                    <Tooltip Title="@($"{p.Resolucion} · {p.Revisor}")" Placement="TooltipPlacement.Left">
                                        <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Resuelta el @p.FechaResolucionTexto</small>
                                    </Tooltip>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="estado-vacio">
            @if (filtro == "Pendientes" && string.IsNullOrWhiteSpace(busqueda))
            {
                <div class="exito-icono"><i class="bi bi-emoji-smile"></i></div>
                <div class="fw-bold fs-5">¡Todo al día!</div>
                <div class="small">No quedan postulaciones por revisar.</div>
            }
            else
            {
                <i class="bi bi-search"></i>
                <div class="fw-semibold">Ninguna postulación coincide con el filtro</div>
            }
        </div>
    }
</div>

@code {
    private string busqueda = "";
    private string filtro = "Pendientes";

    // Postulaciones de la BD, pedidas al servicio REST (GET /postulaciones).
    private List<PostulacionRestDTO> postulaciones = [];
    private bool cargando = true;
    private string? errorCarga;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // De la más reciente a la más antigua.
            postulaciones = (await Rest.ListarPostulacionesAsync())
                .OrderByDescending(p => p.IdPostulacion)
                .ToList();
        }
        catch (Exception ex)
        {
            errorCarga = AcademicoRestService.MensajeDeError(ex);
        }
        finally
        {
            cargando = false;
        }
    }

    private IEnumerable<PostulacionRestDTO> Filtradas => postulaciones
        .Where(p => filtro switch
        {
            "Pendientes" => p.EstadoTexto == "Pendiente",
            "Aprobadas" => p.EstadoTexto == "Aprobada",
            "Rechazadas" => p.EstadoTexto == "Rechazada",
            _ => true,
        })
        .Where(p => string.IsNullOrWhiteSpace(busqueda)
                    || new[] { p.Tutor, p.CodigoPucp, p.Curso, p.CodigoCurso }
                        .Any(texto => texto?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) == true));

    private int Contar(string estado) => postulaciones.Count(p => p.EstadoTexto == estado);

    private static string ClaseEstado(string estado) => estado switch
    {
        "Aprobada" => "text-bg-success",
        "Rechazada" => "text-bg-danger",
        _ => "text-bg-warning",
    };
}
