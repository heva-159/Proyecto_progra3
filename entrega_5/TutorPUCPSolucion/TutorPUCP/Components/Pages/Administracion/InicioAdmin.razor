@page "/admin"
@inject RolActual RolActual

@* Requisitos: RF005, RF006, RF007. Datos de prueba de script_tutorPUCP.sql *@

<PageTitle>Inicio administrador</PageTitle>

<div class="titulo-pagina">
    <div class="d-flex align-items-center gap-3">
        <span class="icono-titulo" style="background:#ffe4e6;color:#e11d48;"><i class="bi bi-speedometer2"></i></span>
        <div>
            <h1 class="h3">Panel del administrador</h1>
            <p>Hola, @RolActual.NombreAdministrador. Revisa las postulaciones de tutores y gestiona el catálogo académico.</p>
        </div>
    </div>
    <a class="btn btn-primary" href="/admin/postulaciones"><i class="bi bi-person-check me-1"></i>Revisar postulaciones</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3 entrar" style="--i: 0;">
        <a class="card kpi tarjeta-hover h-100 text-decoration-none" href="/admin/postulaciones"><div class="card-body d-flex align-items-center gap-3">
            <span class="kpi-icono" style="background:#fef3c7;color:#b45309;"><i class="bi bi-hourglass-split"></i></span>
            <div><div class="kpi-valor">@postulaciones.Count(p => p.Estado == "Pendiente")</div><div class="small text-muted">Postulaciones pendientes</div></div>
        </div></a>
    </div>
    <div class="col-6 col-lg-3 entrar" style="--i: 1;">
        <a class="card kpi tarjeta-hover h-100 text-decoration-none" href="/admin/cursos"><div class="card-body d-flex align-items-center gap-3">
            <span class="kpi-icono" style="background:#dbeafe;color:#1d4ed8;"><i class="bi bi-book"></i></span>
            <div><div class="kpi-valor">3 <span class="fs-6 text-muted">de 4</span></div><div class="small text-muted">Cursos activos</div></div>
        </div></a>
    </div>
    <div class="col-6 col-lg-3 entrar" style="--i: 2;">
        <a class="card kpi tarjeta-hover h-100 text-decoration-none" href="/admin/temas"><div class="card-body d-flex align-items-center gap-3">
            <span class="kpi-icono" style="background:#ede9fe;color:#6d28d9;"><i class="bi bi-tags"></i></span>
            <div><div class="kpi-valor">9</div><div class="small text-muted">Temas registrados</div></div>
        </div></a>
    </div>
    <div class="col-6 col-lg-3 entrar" style="--i: 3;">
        <div class="card kpi h-100"><div class="card-body d-flex align-items-center gap-3">
            <span class="kpi-icono" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-person-check"></i></span>
            <div><div class="kpi-valor">@postulaciones.Where(p => p.Estado == "Aprobada").Select(p => p.Tutor).Distinct().Count()</div><div class="small text-muted">Tutores habilitados</div></div>
        </div></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card h-100 entrar" style="--i: 4;">
            <div class="card-header py-3 d-flex align-items-center justify-content-between">
                <h2 class="h5 mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Postulaciones recientes</h2>
                <a class="small text-decoration-none" href="/admin/postulaciones">Ver todas <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-primary">
                        <tr>
                            <th class="ps-3">Tutor</th>
                            <th>Curso</th>
                            <th>Fecha</th>
                            <th class="pe-3">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in postulaciones)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <Avatar Nombre="@p.Tutor" Tamano="sm" />
                                        <div class="lh-sm">
                                            <div class="fw-semibold">@p.Tutor</div>
                                            <small class="text-muted">@p.Codigo</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@p.Curso</td>
                                <td>@p.Fecha</td>
                                <td class="pe-3"><span class="badge @ClaseEstado(p.Estado)">@p.Estado</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100 entrar" style="--i: 5;">
            <div class="card-body">
                <h2 class="h5 mb-3"><i class="bi bi-lightning-charge me-2 text-primary"></i>Accesos rápidos</h2>
                <div class="d-grid gap-2">
                    @foreach (var (href, icono, texto, detalle) in accesos)
                    {
                        <a class="d-flex align-items-center gap-3 p-3 rounded-4 caja-suave tarjeta-hover text-decoration-none text-body" href="@href">
                            <i class="bi @icono fs-5 text-primary"></i>
                            <span class="lh-sm">
                                <span class="d-block fw-semibold">@texto</span>
                                <small class="text-muted">@detalle</small>
                            </span>
                            <i class="bi bi-chevron-right ms-auto text-muted"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private record Postulacion(string Tutor, string Codigo, string Curso, string Fecha, string Estado);

    // Las 5 postulaciones de script_tutorPUCP.sql, de la más reciente a la más antigua.
    private static readonly Postulacion[] postulaciones =
    [
        new("Ana Lucia Quispe Huaman", "20201234", "Calculo Diferencial", "20/09/2026", "Pendiente"),
        new("Diego Ramirez Torres", "20211567", "Fisica 1", "21/03/2026", "Rechazada"),
        new("Sofia Gutierrez Leon", "20190876", "Fisica 1", "20/03/2026", "Aprobada"),
        new("Diego Ramirez Torres", "20211567", "Calculo Diferencial", "16/03/2026", "Aprobada"),
        new("Ana Lucia Quispe Huaman", "20201234", "Fundamentos de Programacion", "15/03/2026", "Aprobada"),
    ];

    private static readonly (string, string, string, string)[] accesos =
    [
        ("/admin/postulaciones", "bi-person-check", "Postulaciones", "Aprobar o rechazar tutores"),
        ("/admin/cursos", "bi-book", "Cursos", "Registrar, modificar y desactivar"),
        ("/admin/temas", "bi-tags", "Temas", "Temas de cada curso"),
    ];

    private static string ClaseEstado(string estado) => estado switch
    {
        "Aprobada" => "text-bg-success",
        "Rechazada" => "text-bg-danger",
        _ => "text-bg-warning",
    };
}
