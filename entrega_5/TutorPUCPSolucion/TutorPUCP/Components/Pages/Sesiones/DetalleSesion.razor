@page "/sesiones/detalle"
@implements IDisposable
@using System.Globalization
@inject RolActual RolActual
@inject SesionRestService Rest

@* Requisitos: RF012 check-in/check-out y RF013 cancelar, con datos de la BD a través del servicio REST (GestorSesionesRecurso).
   Se abre con ?id=5. Desde aquí se enlazan RF014 (calificar) y RF015 (reclamar). *@

<PageTitle>Detalle de sesión</PageTitle>

<Toasts class="p-3" Messages="avisos" AutoHide="true" Delay="4000" Placement="ToastsPlacement.TopRight" />

<a href="/sesiones" class="small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Volver a mis sesiones</a>

@if (cargando)
{
    <div class="card mt-3"><div class="estado-vacio">
        <div class="spinner-border text-primary mb-2" role="status"></div>
        <div class="fw-semibold">Cargando la sesión...</div>
    </div></div>
}
else if (errorCarga is not null)
{
    <div class="card mt-3"><div class="estado-vacio">
        <i class="bi bi-wifi-off"></i>
        <div class="fw-semibold">No se pudo cargar la sesión</div>
        <div class="small">@errorCarga</div>
    </div></div>
}
else if (sesion is null)
{
    <div class="card mt-3"><div class="estado-vacio">
        <i class="bi bi-calendar-x"></i>
        <div class="fw-semibold">Elige una sesión</div>
        <div class="small">Abre el detalle desde <a href="/sesiones">Mis sesiones</a> o después de <a href="/tutor/sesiones/nueva">registrar una sesión</a>.</div>
    </div></div>
}
else
{
    var s = sesion;

    <div class="titulo-pagina mt-2">
        <div class="d-flex align-items-center gap-3">
            <span class="icono-titulo" style="background:#dbeafe;color:#2563eb;"><i class="bi bi-calendar-check-fill"></i></span>
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <h1 class="h3 mb-0">@s.Curso · @s.TemasTexto</h1>
                    <span class="badge @ClaseEstado" @key="s.Estado" style="animation: tpAparecer .4s ease both;">@s.EstadoTexto</span>
                </div>
                <p>Sesión N.º @s.IdSesion · @FechaTexto(s.Inicio)</p>
            </div>
        </div>
        <a class="btn btn-primary" href="/mensajes/conversacion"><i class="bi bi-chat-dots me-1"></i> Enviar mensaje</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            @* Ciclo de vida de la sesión *@
            <div class="card mb-4 entrar" style="--i: 0;">
                <div class="card-body">
                    <h2 class="h5 mb-3"><i class="bi bi-signpost-split me-2 text-primary"></i>Estado de la sesión</h2>
                    @if (Cancelada)
                    {
                        <div class="nota nota-error d-flex gap-3" style="animation: tpAparecer .4s ease backwards;">
                            <i class="bi bi-x-octagon-fill fs-4"></i>
                            <div>
                                <div class="fw-bold">@s.EstadoTexto</div>
                                <div class="small">@TextoCancelacion</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <Pasos Etapas="Etapas" Actual="PasoActual" />
                        <p class="small text-muted mt-3 mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            @(s.Estado switch
                            {
                                "PROGRAMADA" => "Cuando los dos registren su check-in, la sesión pasa a En curso. Si pasan 15 minutos sin ambos check-in, se cancela por inasistencia.",
                                "EN_CURSO" => "Cuando los dos registren su check-out, la sesión queda Realizada.",
                                _ => "La sesión terminó. El estudiante ya puede calificar al tutor.",
                            })
                        </p>
                    }
                </div>
            </div>

            @* Asistencia: cada uno registra su propio check-in y check-out (RF012) *@
            <div class="card mb-4 entrar" style="--i: 1;">
                <div class="card-body">
                    <h2 class="h5 mb-3"><i class="bi bi-person-check me-2 text-primary"></i>Asistencia</h2>
                    <div class="row g-3">
                        @foreach (var (p, esYo) in new[] { (Yo, true), (Otro, false) })
                        {
                            <div class="col-md-6">
                                <div class="caja-suave rounded-4 p-3 h-100">
                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <Avatar Nombre="@p.Nombre" Tamano="sm" />
                                        <div>
                                            <div class="fw-semibold">@p.Nombre @(esYo ? "(tú)" : "")</div>
                                            <div class="small text-muted">@p.Rol</div>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between small py-1">
                                        <span><i class="bi bi-box-arrow-in-right me-1"></i>Check-in</span>
                                        <span class="@(p.CheckIn ? "fw-semibold text-success" : "text-muted")">@(p.CheckIn ? "Registrado" : "Pendiente")</span>
                                    </div>
                                    <div class="d-flex justify-content-between small py-1">
                                        <span><i class="bi bi-box-arrow-right me-1"></i>Check-out</span>
                                        <span class="@(p.CheckOut ? "fw-semibold text-success" : "text-muted")">@(p.CheckOut ? "Registrado" : "Pendiente")</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                        @if (ocupado)
                        {
                            <span class="small text-muted d-flex align-items-center gap-2">
                                <span class="spinner-border spinner-border-sm text-primary"></span> Guardando…
                            </span>
                        }
                        else if (s.Estado == "PROGRAMADA" && !Yo.CheckIn)
                        {
                            <button class="btn btn-primary" @onclick="HacerCheckIn"><i class="bi bi-box-arrow-in-right me-1"></i> Registrar mi check-in</button>
                        }
                        else if (s.Estado == "EN_CURSO" && !Yo.CheckOut)
                        {
                            <button class="btn btn-primary" @onclick="HacerCheckOut"><i class="bi bi-box-arrow-right me-1"></i> Registrar mi check-out</button>
                        }
                        else if ((s.Estado == "PROGRAMADA" && !Otro.CheckIn) || (s.Estado == "EN_CURSO" && !Otro.CheckOut))
                        {
                            <span class="small text-muted">Falta que @Otro.Nombre lo registre desde su cuenta.</span>
                            <button class="btn btn-sm btn-light" @onclick="Actualizar"><i class="bi bi-arrow-clockwise me-1"></i> Actualizar</button>
                        }
                    </div>
                    @if (!EsParticipante)
                    {
                        <div class="small text-muted mt-2">
                            <i class="bi bi-info-circle me-1"></i>Marcas como @Yo.Rol.ToLower(). Para marcar como el otro, cambia de rol en la barra superior.
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4 entrar" style="--i: 2;">
                <div class="card-body">
                    <h2 class="h5 mb-3"><i class="bi bi-card-list me-2 text-primary"></i>Datos de la sesión</h2>
                    @foreach (var (icono, etiqueta, valor) in Datos)
                    {
                        <div class="d-flex gap-2 py-2">
                            <i class="bi @icono text-primary"></i>
                            <div>
                                <div class="small text-muted">@etiqueta</div>
                                <div class="fw-semibold">@valor</div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card entrar" style="--i: 3;">
                <div class="card-body d-grid gap-2">
                    <h2 class="h5 mb-1"><i class="bi bi-lightning-charge me-2 text-primary"></i>Acciones</h2>

                    @if (!SoyTutor)
                    {
                        <a class="btn btn-primary @(s.Estado == "REALIZADA" ? "" : "disabled")" href="@($"/sesiones/calificar?id={s.IdSesion}")">
                            <i class="bi bi-star me-1"></i> Calificar al tutor
                        </a>
                    }
                    <a class="btn btn-outline-danger @(PuedeReclamar ? "" : "disabled")" href="/reclamos/nuevo?abrir=true">
                        <i class="bi bi-flag me-1"></i> Registrar reclamo
                    </a>
                    <button class="btn btn-outline-secondary" disabled="@(!PuedeCancelar || ocupado)" @onclick="AbrirCancelar">
                        <i class="bi bi-x-circle me-1"></i> Cancelar sesión
                    </button>
                    <button class="btn btn-light" disabled="@ocupado" @onclick="Actualizar">
                        <i class="bi bi-arrow-clockwise me-1"></i> Actualizar
                    </button>

                    <div class="small text-muted mt-1">
                        @if (s.Estado == "PROGRAMADA" && !PuedeCancelar)
                        {
                            <span>Ya no se puede cancelar porque alguien registró su check-in.</span>
                        }
                        else if (!PuedeReclamar)
                        {
                            <span>El reclamo se habilita cuando la sesión termina o se cancela por inasistencia.</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* Cancelar solo mientras está Programada, con motivo obligatorio (RF013) *@
<Modal @ref="modalCancelar" Title="Cancelar sesión" IsVerticallyCentered="true">
    <BodyTemplate>
        <p class="mb-2">Cuéntale a @(sesion is null ? "la otra persona" : Otro.Nombre) por qué se cancela la sesión.</p>
        <textarea class="form-control" rows="3" maxlength="255" placeholder="Motivo de la cancelación"
                  @bind="motivo" @bind:event="oninput"></textarea>
        <div class="d-flex justify-content-between small mt-1">
            <span class="text-danger">@(DatosContacto.Contiene(motivo) ? "No escribas correos ni teléfonos." : "")</span>
            <span class="text-muted">@motivo.Length/255</span>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => modalCancelar.HideAsync()">Volver</button>
        <button type="button" class="btn btn-danger" disabled="@(!MotivoValido || ocupado)" @onclick="Cancelar">Cancelar sesión</button>
    </FooterTemplate>
</Modal>

@code {
    // Viene en la URL: /sesiones/detalle?id=5
    [SupplyParameterFromQuery(Name = "id")] public int? Id { get; set; }

    private record Persona(string Nombre, string Rol, bool CheckIn, bool CheckOut);

    private static readonly string[] Etapas = ["Programada", "En curso", "Realizada"];
    private static readonly CultureInfo Peru = new("es-PE");

    private Modal modalCancelar = default!;
    private readonly List<ToastMessage> avisos = [];

    // La sesión de la BD (GET /sesion/{id}); se reemplaza con lo que devuelve el REST después de cada acción.
    private SesionRestDTO? sesion;
    private bool cargando = true;
    private string? errorCarga;
    private bool ocupado;   // evita mandar dos veces la misma acción
    private string motivo = "";

    // Quién soy en esta sesión: si inicié sesión y soy su tutor o su estudiante, ese papel;
    // si no, el rol elegido en la barra superior (sirve para probar los dos lados en la demo).
    private int? IdUsuarioActual => RolActual.Usuario?.IdUsuario;
    private bool EsParticipante => sesion is not null && (IdUsuarioActual == sesion.IdTutor || IdUsuarioActual == sesion.IdEstudiante);
    private bool SoyTutor => sesion is not null
                             && (IdUsuarioActual == sesion.IdTutor
                                 || (IdUsuarioActual != sesion.IdEstudiante && RolActual.Rol == RolActual.Tutor));

    private Persona PersonaTutor => new(sesion!.Tutor, "Tutor", sesion.CheckInTutor, sesion.CheckOutTutor);
    private Persona PersonaEstudiante => new(sesion!.Estudiante, "Estudiante", sesion.CheckInEstudiante, sesion.CheckOutEstudiante);
    private Persona Yo => SoyTutor ? PersonaTutor : PersonaEstudiante;
    private Persona Otro => SoyTutor ? PersonaEstudiante : PersonaTutor;

    private bool Cancelada => sesion?.Estado is "CANCELADA" or "CANCELADA_INASISTENCIA";
    private bool PuedeCancelar => sesion is not null && sesion.Estado == "PROGRAMADA" && !sesion.CheckInTutor && !sesion.CheckInEstudiante;
    private bool PuedeReclamar => sesion?.Estado is "REALIZADA" or "CANCELADA_INASISTENCIA";
    private bool MotivoValido => !string.IsNullOrWhiteSpace(motivo) && !DatosContacto.Contiene(motivo);

    private int PasoActual => sesion?.Estado switch { "PROGRAMADA" => 0, "EN_CURSO" => 1, _ => 3 };

    private string ClaseEstado => sesion?.Estado switch
    {
        "PROGRAMADA" => "text-bg-primary",
        "EN_CURSO" => "text-bg-warning",
        "REALIZADA" => "text-bg-success",
        _ => "text-bg-danger",
    };

    private string TextoCancelacion
    {
        get
        {
            if (sesion is null) return "";
            if (sesion.Estado == "CANCELADA_INASISTENCIA")
                return "Pasaron 15 minutos desde la hora de inicio sin que ambos registraran su check-in. Ya se puede registrar un reclamo.";
            return $"Cancelada por {sesion.Cancelo ?? "uno de los participantes"}: {sesion.MotivoCancelacion}";
        }
    }

    private IEnumerable<(string, string, string)> Datos
    {
        get
        {
            if (sesion is null) return [];
            return
            [
                ("bi-book", "Curso", $"{sesion.CodigoCurso} · {sesion.Curso}"),
                ("bi-bookmark", "Temas", sesion.TemasTexto),
                ("bi-calendar-event", "Fecha y hora", FechaTexto(sesion.Inicio)),
                ("bi-person-workspace", "Tutor", sesion.Tutor),
                ("bi-backpack2", "Estudiante", sesion.Estudiante),
                ("bi-cash-coin", "Tarifa", sesion.TarifaTexto),
            ];
        }
    }

    // "martes 27/10/2026 · 4:00 p. m."
    private static string FechaTexto(DateTime? fecha) =>
        fecha is DateTime f
            ? $"{f.ToString("dddd dd/MM/yyyy", Peru)} · {(f.Hour % 12 == 0 ? 12 : f.Hour % 12)}:{f.Minute:00} {(f.Hour < 12 ? "a. m." : "p. m.")}"
            : "—";

    protected override async Task OnInitializedAsync()
    {
        RolActual.Cambio += AlCambiarRol;
        try
        {
            if (Id is int id && id > 0)
            {
                sesion = await Rest.ObtenerAsync(id);
            }
        }
        catch (Exception ex)
        {
            errorCarga = AcademicoRestService.MensajeDeError(ex);
        }
        finally
        {
            cargando = false;
        }
    }

    // Al cambiar de rol arriba, cambia quién es "yo" y quién es "el otro".
    private void AlCambiarRol() => InvokeAsync(StateHasChanged);

    // Vuelve a pedir la sesión (por ejemplo, para ver si la otra persona ya marcó).
    private async Task Actualizar()
    {
        if (ocupado || sesion is null) return;
        ocupado = true;
        try
        {
            sesion = await Rest.ObtenerAsync(sesion.IdSesion);
        }
        catch (Exception ex)
        {
            Avisar(ToastType.Danger, "No se pudo actualizar", AcademicoRestService.MensajeDeError(ex));
        }
        finally
        {
            ocupado = false;
        }
    }

    private Task HacerCheckIn() => MarcarAsistencia(true);

    private Task HacerCheckOut() => MarcarAsistencia(false);

    // PUT /sesion/{id}/checkin o /checkout con mi rol (TUTOR o ESTUDIANTE)
    private async Task MarcarAsistencia(bool esCheckIn)
    {
        if (ocupado || sesion is null) return;
        ocupado = true;
        var accion = esCheckIn ? "check-in" : "check-out";
        var rol = SoyTutor ? "TUTOR" : "ESTUDIANTE";
        try
        {
            sesion = esCheckIn
                ? await Rest.CheckInAsync(sesion.IdSesion, rol)
                : await Rest.CheckOutAsync(sesion.IdSesion, rol);

            var mensaje = sesion.Estado switch
            {
                "EN_CURSO" when esCheckIn => "Los dos registraron su check-in: la sesión está en curso.",
                "REALIZADA" => "Los dos registraron su check-out: la sesión quedó realizada.",
                _ => $"Falta el {accion} de {Otro.Nombre}.",
            };
            Avisar(ToastType.Success, $"Tu {accion} quedó registrado", mensaje);
        }
        catch (Exception ex)
        {
            Avisar(ToastType.Danger, $"No se pudo registrar el {accion}", AcademicoRestService.MensajeDeError(ex));
        }
        finally
        {
            ocupado = false;
        }
    }

    private async Task AbrirCancelar()
    {
        motivo = "";
        await modalCancelar.ShowAsync();
    }

    // PUT /sesion/{id}/cancelacion. Cancela quien soy en la sesión (su tutor o su estudiante).
    private async Task Cancelar()
    {
        if (ocupado || sesion is null || !MotivoValido) return;
        ocupado = true;
        try
        {
            var otro = Otro.Nombre;
            var formulario = new CancelarSesionFormulario
            {
                IdUsuario = SoyTutor ? sesion.IdTutor : sesion.IdEstudiante,
                Motivo = motivo.Trim(),
            };
            sesion = await Rest.CancelarAsync(sesion.IdSesion, formulario);
            await modalCancelar.HideAsync();
            Avisar(ToastType.Warning, "Sesión cancelada", $"{otro} verá el motivo en el detalle de la sesión.");
        }
        catch (Exception ex)
        {
            Avisar(ToastType.Danger, "No se pudo cancelar la sesión", AcademicoRestService.MensajeDeError(ex));
        }
        finally
        {
            ocupado = false;
        }
    }

    private void Avisar(ToastType tipo, string titulo, string texto) =>
        avisos.Add(new ToastMessage { Type = tipo, Title = titulo, Message = texto });

    public void Dispose() => RolActual.Cambio -= AlCambiarRol;
}
