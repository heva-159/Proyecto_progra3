@page "/tutor/postulaciones"

@* Responsable: Integrante 3 - Tutor y búsqueda *@

<PageTitle>Mis postulaciones</PageTitle>

@* =============================================================================
   ENCABEZADO Y BOTÓN DE ACCIÓN
   - "d-flex justify-content-between": Título a la izquierda, botón a la derecha.
   - El botón lleva a la pantalla anterior: /tutor/postular
   ============================================================================= *@
<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="text-primary fw-bold mb-1">Mis Postulaciones a Cursos</h2>
        <p class="text-muted mb-0">Consulta el historial y el estado de acreditación de tus solicitudes académicas.</p>
    </div>
    <a href="/tutor/postular" class="btn btn-primary shadow-sm">
        + Nueva Postulación
    </a>
</div>
@* =============================================================================
   TARJETAS DE RESUMEN RÁPIDO
   Muestra un conteo rápido de cuántas postulaciones están aprobadas o en revisión.
   ============================================================================= *@
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 p-3 bg-light text-center">
            <span class="text-muted small fw-semibold">TOTAL POSTULACIONES</span>
            <h4 class="text-dark fw-bold mb-0">@listaPostulaciones.Count</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 p-3 bg-light text-center">
            <span class="text-muted small fw-semibold">APROBADAS</span>
            <h4 class="text-success fw-bold mb-0">
                @listaPostulaciones.Count(p => p.Estado == "APROBADA")
            </h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 p-3 bg-light text-center">
            <span class="text-muted small fw-semibold">EN REVISIÓN</span>
            <h4 class="text-warning fw-bold mb-0">
                @listaPostulaciones.Count(p => p.Estado == "PENDIENTE")
            </h4>
        </div>
    </div>
</div>
@* =============================================================================
   TABLA DE POSTULACIONES 
   - "table-hover": Ilumina la fila donde el usuario pone el mouse.
   - "align-middle": Centra verticalmente el texto en cada celda.
   ============================================================================= *@
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-0">
        <h5 class="fw-bold mb-0 text-dark">Historial de Solicitudes</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Curso</th>
                        <th>Fecha de Envío</th>
                        <th>Certificado PDF</th>
                        <th>Estado</th>
                        <th>Resolución / Observación del Administrador</th>
                    </tr>
                </thead>
                <tbody>
                    @* Verificamos que la lista no sea null antes de recorrerla *@
                    @if (listaPostulaciones != null && listaPostulaciones.Count > 0)
                    {
                        @foreach (var post in listaPostulaciones)
                        {
                            <tr>
                                @* Nombre del curso *@
                                <td class="ps-3 fw-semibold">@post.Curso</td>
                                @* Fecha en que se envió *@
                                <td class="text-muted">@post.FechaEnvio</td>
                                @* Archivo adjunto con ícono simulado *@
                                <td>
                                    <span class="badge bg-secondary text-white">
                                        📄 @post.ArchivoPdf
                                    </span>
                                </td>
                                @* Estado con insignia de color dinámico *@
                                <td>
                                    <span class="badge @ObtenerColorBadge(post.Estado)">
                                        @post.Estado
                                    </span>
                                </td>
                                @* Dictamen del administrador *@
                                <td class="small @(post.Estado == "RECHAZADA" ? "text-danger" : "text-muted")">
                                    @post.Resolucion
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No tienes ninguna postulación registrada todavía.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@* Botón para regresar al panel *@
<div class="mt-3">
    <a href="/tutor" class="btn btn-outline-secondary btn-sm">
        ← Volver al Panel del Tutor
    </a>
</div>
@* =============================================================================
   LÓGICA Y MODELO EN C# 
   Lista simulada con los 3 estados posibles (Aprobada, Pendiente, Rechazada).
   ============================================================================= *@
@code {
    // Lista simulada de postulaciones
    private List<PostulacionItem> listaPostulaciones = new()
    {
        new PostulacionItem
        {
            Curso = "1INF30 - Programación 3",
            FechaEnvio = "15/10/2026",
            ArchivoPdf = "cert_notas_progra3.pdf",
            Estado = "APROBADA",
            Resolucion = "Aprobado por coordinación. Nota superior a 16."
        },
        new PostulacionItem
        {
            Curso = "1INF08 - Base de Datos",
            FechaEnvio = "22/10/2026",
            ArchivoPdf = "certificado_bd.pdf",
            Estado = "PENDIENTE",
            Resolucion = "En evaluación por el docente del curso."
        },
        new PostulacionItem
        {
            Curso = "1MAT05 - Cálculo 1",
            FechaEnvio = "05/09/2026",
            ArchivoPdf = "notas_calculo.pdf",
            Estado = "RECHAZADA",
            Resolucion = "Rechazado: La nota mínima de acreditación para tutor es 15."
        }
    };
    // Método de C# para elegir el color según el estado
    private string ObtenerColorBadge(string estado)
    {
        return estado switch
        {
            "APROBADA" => "bg-success",           // Verde
            "PENDIENTE" => "bg-warning text-dark", // Amarillo
            "RECHAZADA" => "bg-danger",           // Rojo
            _ => "bg-secondary"
        };
    }
    // Clase interna que modela los datos de cada fila
    public class PostulacionItem
    {
        public string Curso { get; set; } = "";
        public string FechaEnvio { get; set; } = "";
        public string ArchivoPdf { get; set; } = "";
        public string Estado { get; set; } = "";
        public string Resolucion { get; set; } = "";
    }
}
