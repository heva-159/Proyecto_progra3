@page "/admin/temas"

<PageTitle>Temas</PageTitle>

<h1 class="h3 mb-1">Temas</h1>
<p class="text-muted mb-4">Registra, modifica o elimina los temas de cada curso.</p>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label for="curso" class="form-label">Curso</label>
                <select id="curso" class="form-select">
                    <option selected>1INF01 - Fundamentos de Programacion</option>
                    <option>1MAT05 - Calculo Diferencial</option>
                    <option>1FIS01 - Fisica 1</option>
                    <option>1QUI01 - Quimica 1 (inactivo)</option>
                </select>
            </div>
            <div class="col-md-4">
                <label for="nuevoTema" class="form-label">Nuevo tema</label>
                <input id="nuevoTema" type="text" class="form-control" placeholder="Nombre del tema" />
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-primary w-100">Agregar</button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h5 mb-3">Temas de Fundamentos de Programacion</h2>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th>#</th>
                        <th>Nombre</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>Variables y tipos de datos</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-primary">Editar</button>
                            <button type="button" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Estructuras condicionales</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-primary">Editar</button>
                            <button type="button" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>Estructuras repetitivas</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-primary">Editar</button>
                            <button type="button" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="form-text mb-0 mt-3">Los temas que ya se usaron en alguna sesión no se pueden eliminar.</p>
    </div>
</div>
