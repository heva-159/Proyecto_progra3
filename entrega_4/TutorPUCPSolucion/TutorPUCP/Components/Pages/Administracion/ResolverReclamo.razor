@page "/admin/reclamos/resolver"

@* Requisito: RF016 *@

<PageTitle>Resolver reclamo</PageTitle>

<Toasts class="p-3" Messages="avisos" AutoHide="true" Delay="4500" Placement="ToastsPlacement.TopRight" />

<a href="/admin/reclamos" class="small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Volver a reclamos pendientes</a>

<div class="titulo-pagina mt-2">
    <div class="d-flex align-items-center gap-3">
        <span class="icono-titulo" style="background:#fee2e2;color:#dc2626;"><i class="bi bi-flag-fill"></i></span>
        <div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="h3 mb-0">Resolver reclamo N.º 12</h1>
                <span class="badge @ClaseEstado" @key="estado" style="animation: tpAparecer .4s ease both;">@estado</span>
            </div>
            <p>Registrado el 24/10/2026 · hace 3 días</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card mb-4 entrar" style="--i: 0;">
            <div class="card-body">
                <h2 class="h5 mb-3"><i class="bi bi-chat-square-text me-2 text-primary"></i>Reclamo</h2>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <Avatar Nombre="Lucía Ramos" />
                    <div class="lh-sm">
                        <div class="fw-bold">Lucía Ramos</div>
                        <small class="text-muted">Reclama como <b>Estudiante</b></small>
                    </div>
                </div>
                <div class="p-3 rounded-4 caja-suave">
                    <i class="bi bi-quote text-primary fs-4"></i>
                    El tutor llegó 30 minutos tarde y la sesión se acortó.
                </div>
            </div>
        </div>

        <div class="card entrar" style="--i: 1;">
            <div class="card-body">
                <h2 class="h5 mb-3"><i class="bi bi-calendar-check me-2 text-primary"></i>Sesión</h2>
                <dl class="row datos mb-3">
                    <dt class="col-5">Curso</dt>
                    <dd class="col-7">Cálculo 1</dd>
                    <dt class="col-5">Tutor</dt>
                    <dd class="col-7">Andrés Villanueva</dd>
                    <dt class="col-5">Estudiante</dt>
                    <dd class="col-7">Lucía Ramos</dd>
                    <dt class="col-5">Inicio programado</dt>
                    <dd class="col-7">23/10/2026, 4:00 p. m.</dd>
                    <dt class="col-5">Estado</dt>
                    <dd class="col-7 mb-0"><span class="badge text-bg-success">Realizada</span></dd>
                </dl>

                <div class="small text-uppercase text-muted fw-bold mb-2">Registro de asistencia</div>
                <ul class="list-unstyled mb-0 small">
                    @foreach (var (hora, texto, color) in Linea)
                    {
                        <li class="d-flex gap-2 align-items-start mb-2">
                            <span class="rounded-circle flex-shrink-0 mt-1" style="width:10px;height:10px;background:@color;"></span>
                            <span><b>@hora</b> · @texto</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100 entrar" style="--i: 2;">
            <div class="card-body">
                @if (estado == "Pendiente")
                {
                    <Pasos Etapas="Etapas" Actual="@(decision == "" ? 1 : 2)" />

                    <h2 class="h5 mb-3">Resolución</h2>

                    <label class="form-label fw-semibold">Decisión</label>
                    <div class="d-grid gap-2 mb-3">
                        <button type="button" class="opcion-tarjeta aprobar @(decision == "Aprobado" ? "elegida" : "")" @onclick="@(() => decision = "Aprobado")">
                            <span class="opcion-marca"><i class="bi bi-check"></i></span>
                            <span class="lh-sm"><b class="text-success"><i class="bi bi-hand-thumbs-up me-1"></i>Aprobar reclamo</b><br /><small class="text-muted">El reclamo procede</small></span>
                        </button>
                        <button type="button" class="opcion-tarjeta rechazar @(decision == "Rechazado" ? "elegida" : "")" @onclick="@(() => decision = "Rechazado")">
                            <span class="opcion-marca"><i class="bi bi-check"></i></span>
                            <span class="lh-sm"><b class="text-danger"><i class="bi bi-hand-thumbs-down me-1"></i>Rechazar reclamo</b><br /><small class="text-muted">El reclamo no procede</small></span>
                        </button>
                    </div>

                    <label for="resolucion" class="form-label fw-semibold">Resolución</label>
                    <textarea id="resolucion" class="form-control" rows="5" maxlength="255"
                              placeholder="Explica la decisión que se comunicará al reclamante."
                              @bind="resolucion" @bind:event="oninput"></textarea>
                    <div class="d-flex justify-content-between mt-1 mb-3">
                        <small class="text-muted">Obligatoria.</small>
                        <small class="contador-caracteres @(resolucion.Length > 220 ? "cerca" : "")">@resolucion.Length / 255</small>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-secondary" href="/admin/reclamos">Cancelar</a>
                        <button type="button" class="btn btn-primary" disabled="@(decision == "" || string.IsNullOrWhiteSpace(resolucion))"
                                @onclick="() => confirmar.ShowAsync()">
                            <i class="bi bi-save me-1"></i>Guardar resolución
                        </button>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 paso-panel">
                        <div class="exito-icono @(estado == "Rechazado" ? "rechazo" : "")">
                            <i class="bi @(estado == "Aprobado" ? "bi-check-lg" : "bi-x-lg")"></i>
                        </div>
                        <h2 class="h4">Reclamo @estado.ToLower()</h2>
                        <p class="text-muted">Resuelto por el administrador el @DateTime.Today.ToString("dd/MM/yyyy").</p>
                        <div class="text-start p-3 rounded-4 mb-4 caja-suave">
                            <div class="small text-uppercase text-muted fw-bold mb-1">Resolución</div>
                            @resolucion
                        </div>
                        <a class="btn btn-primary" href="/admin/reclamos"><i class="bi bi-arrow-left me-1"></i>Volver a pendientes</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<Modal @ref="confirmar" Title="Confirmar resolución" IsVerticallyCentered="true">
    <BodyTemplate>
        <Pasos Etapas="Etapas" Actual="2" />
        <p class="mb-2">Vas a <b class="@(decision == "Aprobado" ? "text-success" : "text-danger")">@(decision == "Aprobado" ? "aprobar" : "rechazar")</b> el reclamo N.º 12 de Lucía Ramos.</p>
        <div class="p-3 rounded-4 small caja-suave">@resolucion</div>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => confirmar.HideAsync()">Revisar otra vez</button>
        <button type="button" class="btn @(decision == "Aprobado" ? "btn-success" : "btn-danger")" @onclick="Guardar">Sí, guardar</button>
    </FooterTemplate>
</Modal>

@code {
    private static readonly string[] Etapas = ["Revisar", "Decidir", "Confirmar"];

    private static readonly (string, string, string)[] Linea =
    [
        ("4:00 p. m.", "Check-in de la estudiante", "#16a34a"),
        ("4:30 p. m.", "Check-in del tutor (30 min tarde)", "#d97706"),
        ("5:00 p. m.", "Check-out de ambos", "#2563eb"),
    ];

    private Modal confirmar = default!;
    private readonly List<ToastMessage> avisos = [];

    private string estado = "Pendiente";
    private string decision = "";
    private string resolucion = "";

    private string ClaseEstado => estado switch
    {
        "Aprobado" => "text-bg-success",
        "Rechazado" => "text-bg-danger",
        _ => "text-bg-warning",
    };

    private async Task Guardar()
    {
        await confirmar.HideAsync();
        estado = decision;
        avisos.Add(new ToastMessage
        {
            Type = estado == "Aprobado" ? ToastType.Success : ToastType.Danger,
            Title = $"Reclamo N.º 12 {estado.ToLower()}",
            Message = "Se notificará la resolución a Lucía Ramos.",
        });
    }
}
