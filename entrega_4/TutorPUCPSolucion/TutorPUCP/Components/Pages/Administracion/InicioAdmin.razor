@page "/admin"

<PageTitle>Inicio administrador</PageTitle>

<h1 class="h3 mb-1">Panel del administrador</h1>
<p class="text-muted mb-4">Bienvenida, Carla Mendoza Rios. Revisa las postulaciones de tutores y gestiona el catálogo académico.</p>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column">
                <div class="text-muted small text-uppercase">Postulaciones pendientes</div>
                <div class="display-6 fw-semibold mb-3">1</div>
                <a class="btn btn-primary mt-auto" href="/admin/postulaciones">Revisar postulaciones</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column">
                <div class="text-muted small text-uppercase">Cursos activos</div>
                <div class="display-6 fw-semibold mb-3">3 <span class="fs-6 text-muted">de 4</span></div>
                <a class="btn btn-outline-primary mt-auto" href="/admin/cursos">Gestionar cursos</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column">
                <div class="text-muted small text-uppercase">Temas registrados</div>
                <div class="display-6 fw-semibold mb-3">9</div>
                <a class="btn btn-outline-primary mt-auto" href="/admin/temas">Gestionar temas</a>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">Postulaciones recientes</h2>
            <a class="small" href="/admin/postulaciones">Ver pendientes</a>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th>Fecha</th>
                        <th>Tutor</th>
                        <th>Curso</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>20/09/2026</td>
                        <td>Ana Lucia Quispe Huaman</td>
                        <td>Calculo Diferencial</td>
                        <td><span class="badge text-bg-warning">Pendiente</span></td>
                    </tr>
                    <tr>
                        <td>21/03/2026</td>
                        <td>Diego Ramirez Torres</td>
                        <td>Fisica 1</td>
                        <td><span class="badge text-bg-danger">Rechazada</span></td>
                    </tr>
                    <tr>
                        <td>20/03/2026</td>
                        <td>Sofia Gutierrez Leon</td>
                        <td>Fisica 1</td>
                        <td><span class="badge text-bg-success">Aprobada</span></td>
                    </tr>
                    <tr>
                        <td>16/03/2026</td>
                        <td>Diego Ramirez Torres</td>
                        <td>Calculo Diferencial</td>
                        <td><span class="badge text-bg-success">Aprobada</span></td>
                    </tr>
                    <tr>
                        <td>15/03/2026</td>
                        <td>Ana Lucia Quispe Huaman</td>
                        <td>Fundamentos de Programacion</td>
                        <td><span class="badge text-bg-success">Aprobada</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
