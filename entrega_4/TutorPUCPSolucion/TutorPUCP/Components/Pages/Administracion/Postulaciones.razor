@page "/admin/postulaciones"

@* Responsable: Integrante 2 - Administrador: catálogo (RF005). Datos de prueba de script_tutorPUCP.sql *@

<PageTitle>Postulaciones</PageTitle>

<div class="titulo-pagina">
    <div class="d-flex align-items-center gap-3">
        <span class="icono-titulo" style="background:linear-gradient(135deg,#fef3c7,#fffbeb);color:#b45309;"><i class="bi bi-person-check-fill"></i></span>
        <div>
            <h1 class="h3">Postulaciones</h1>
            <p>Revisa el certificado de notas de cada tutor y aprueba o rechaza su postulación al curso.</p>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-4 entrar" style="--i: 0;">
        <div class="card kpi h-100"><div class="card-body d-flex align-items-center gap-3">
            <span class="kpi-icono" style="background:#fef3c7;color:#b45309;"><i class="bi bi-hourglass-split"></i></span>
            <div><div class="kpi-valor">@Contar("Pendiente")</div><div class="small text-muted">Por revisar</div></div>
        </div></div>
    </div>
    <div class="col-sm-4 entrar" style="--i: 1;">
        <div class="card kpi h-100"><div class="card-body d-flex align-items-center gap-3">
            <span class="kpi-icono" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-check2-circle"></i></span>
            <div><div class="kpi-valor">@Contar("Aprobada")</div><div class="small text-muted">Aprobadas</div></div>
        </div></div>
    </div>
    <div class="col-sm-4 entrar" style="--i: 2;">
        <div class="card kpi h-100"><div class="card-body d-flex align-items-center gap-3">
            <span class="kpi-icono" style="background:#fee2e2;color:#dc2626;"><i class="bi bi-x-circle"></i></span>
            <div><div class="kpi-valor">@Contar("Rechazada")</div><div class="small text-muted">Rechazadas</div></div>
        </div></div>
    </div>
</div>

<div class="card">
    <div class="card-header py-3">
        <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <div class="position-relative flex-grow-1" style="max-width: 340px;">
                <i class="bi bi-search position-absolute text-muted" style="left: .8rem; top: 50%; transform: translateY(-50%);"></i>
                <input type="text" class="form-control ps-5" placeholder="Tutor, código o curso" aria-label="Buscar"
                       @bind="busqueda" @bind:event="oninput" />
            </div>
            <div class="segmento" role="group" aria-label="Estado de la postulación">
                @foreach (var e in new[] { "Pendientes", "Aprobadas", "Rechazadas", "Todas" })
                {
                    <button type="button" class="@(filtro == e ? "activo" : "")" @onclick="() => filtro = e">@e</button>
                }
            </div>
        </div>
    </div>

    @if (Filtradas.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th class="ps-3">Tutor</th>
                        <th>Curso</th>
                        <th>Fecha</th>
                        <th>Certificado</th>
                        <th>Estado</th>
                        <th class="text-end pe-3">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var i = 0; }
                    @foreach (var p in Filtradas)
                    {
                        <tr class="entrar" style="--i: @(i++);" @key="p.Numero">
                            <td class="ps-3">
                                <div class="d-flex align-items-center gap-2">
                                    <Avatar Nombre="@p.Tutor" Tamano="sm" />
                                    <div class="lh-sm">
                                        <div class="fw-semibold">@p.Tutor</div>
                                        <small class="text-muted">Código @p.Codigo</small>
                                    </div>
                                </div>
                            </td>
                            <td><div class="fw-semibold">@p.Curso</div><small class="text-muted">@p.CodigoCurso</small></td>
                            <td>@p.Fecha</td>
                            <td class="text-nowrap"><i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i><small>@p.Certificado</small></td>
                            <td><span class="badge @ClaseEstado(p.Estado)">@p.Estado</span></td>
                            <td class="text-end pe-3 text-nowrap">
                                @if (p.Estado == "Pendiente")
                                {
                                    <a class="btn btn-primary btn-sm" href="/admin/postulaciones/revisar">
                                        <i class="bi bi-clipboard-check me-1"></i>Revisar
                                    </a>
                                }
                                else
                                {
                                    <Tooltip Title="@($"{p.Resolucion} · {p.Revisor}")" Placement="TooltipPlacement.Left">
                                        <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Resuelta el @p.FechaResolucion</small>
                                    </Tooltip>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="estado-vacio">
            @if (filtro == "Pendientes" && string.IsNullOrWhiteSpace(busqueda))
            {
                <div class="exito-icono"><i class="bi bi-emoji-smile"></i></div>
                <div class="fw-bold fs-5">¡Todo al día!</div>
                <div class="small">No quedan postulaciones por revisar.</div>
            }
            else
            {
                <i class="bi bi-search"></i>
                <div class="fw-semibold">Ninguna postulación coincide con el filtro</div>
            }
        </div>
    }
</div>

@code {
    private record Postulacion(int Numero, string Tutor, string Codigo, string CodigoCurso, string Curso, string Fecha,
        string Certificado, string Estado, string FechaResolucion = "", string Resolucion = "", string Revisor = "");

    private string busqueda = "";
    private string filtro = "Pendientes";

    // Las 5 postulaciones de script_tutorPUCP.sql.
    private static readonly Postulacion[] postulaciones =
    [
        new(5, "Ana Lucia Quispe Huaman", "20201234", "1MAT05", "Calculo Diferencial", "20/09/2026", "20201234_1MAT05.pdf", "Pendiente"),
        new(4, "Diego Ramirez Torres", "20211567", "1FIS01", "Fisica 1", "21/03/2026", "20211567_1FIS01.pdf", "Rechazada",
            "23/03/2026", "El certificado no es legible", "Jorge Salas Vega"),
        new(3, "Sofia Gutierrez Leon", "20190876", "1FIS01", "Fisica 1", "20/03/2026", "20190876_1FIS01.pdf", "Aprobada",
            "22/03/2026", "Nota 16 en el curso", "Jorge Salas Vega"),
        new(2, "Diego Ramirez Torres", "20211567", "1MAT05", "Calculo Diferencial", "16/03/2026", "20211567_1MAT05.pdf", "Aprobada",
            "19/03/2026", "Nota 17 en el curso", "Carla Mendoza Rios"),
        new(1, "Ana Lucia Quispe Huaman", "20201234", "1INF01", "Fundamentos de Programacion", "15/03/2026", "20201234_1INF01.pdf", "Aprobada",
            "18/03/2026", "Nota 18 en el curso", "Carla Mendoza Rios"),
    ];

    private IEnumerable<Postulacion> Filtradas => postulaciones
        .Where(p => filtro switch
        {
            "Pendientes" => p.Estado == "Pendiente",
            "Aprobadas" => p.Estado == "Aprobada",
            "Rechazadas" => p.Estado == "Rechazada",
            _ => true,
        })
        .Where(p => string.IsNullOrWhiteSpace(busqueda)
                    || p.Tutor.Contains(busqueda, StringComparison.OrdinalIgnoreCase)
                    || p.Codigo.Contains(busqueda, StringComparison.OrdinalIgnoreCase)
                    || p.Curso.Contains(busqueda, StringComparison.OrdinalIgnoreCase)
                    || p.CodigoCurso.Contains(busqueda, StringComparison.OrdinalIgnoreCase));

    private static int Contar(string estado) => postulaciones.Count(p => p.Estado == estado);

    private static string ClaseEstado(string estado) => estado switch
    {
        "Aprobada" => "text-bg-success",
        "Rechazada" => "text-bg-danger",
        _ => "text-bg-warning",
    };
}
