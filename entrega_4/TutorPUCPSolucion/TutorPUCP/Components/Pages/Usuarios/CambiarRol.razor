@page "/cambiar-rol"
@layout AuthLayout

<PageTitle>Cambiar rol</PageTitle>

<h1 class="h3 text-center mb-2">Cambiar rol</h1>
<p class="text-center text-muted mb-4">¿Con qué perfil quieres ingresar? Puedes cambiarlo cuando quieras desde la barra superior.</p>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column p-4">
                <h2 class="h4">Estudiante</h2>
                <p class="text-muted">Busca tutores por curso, agenda sesiones y califica la atención recibida.</p>
                <a class="btn btn-primary mt-auto" href="/estudiante">Entrar como estudiante</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column p-4">
                <h2 class="h4">Tutor</h2>
                <p class="text-muted">Postula a cursos, define tus tarifas y dicta tus sesiones.</p>
                <a class="btn btn-primary mt-auto" href="/tutor">Entrar como tutor</a>
            </div>
        </div>
    </div>
</div>