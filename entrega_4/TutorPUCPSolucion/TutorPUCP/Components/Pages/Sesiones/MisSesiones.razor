@page "/sesiones"
@implements IDisposable
@inject RolActual RolActual

<PageTitle>Mis sesiones</PageTitle>

<div class="titulo-pagina">
    <div class="d-flex align-items-center gap-3">
        <span class="icono-titulo"><i class="bi bi-calendar-week-fill"></i></span>
        <div>
            <h1 class="h3">Mis sesiones</h1>
            <p>@(EsTutor
                ? "Las tutorías que registraste con tus estudiantes."
                : "Tus tutorías agendadas y pasadas. Entra a una para hacer check-in, calificar o reclamar.")</p>
        </div>
    </div>
    @if (EsTutor)
    {
        <a class="btn btn-primary" href="/tutor/sesiones/nueva"><i class="bi bi-calendar-plus me-1"></i>Registrar sesión</a>
    }
    else
    {
        <a class="btn btn-primary" href="/estudiante/buscar-tutores"><i class="bi bi-compass me-1"></i>Buscar tutores</a>
    }
</div>

<div class="row g-3 mb-4">
    @{ var k = 0; }
    @foreach (var (titulo, valor, icono) in Resumen)
    {
        <div class="col-6 col-lg-3 entrar" style="--i: @(k++);">
            <div class="card kpi h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="kpi-icono"><i class="bi @icono"></i></span>
                    <div><div class="kpi-valor">@valor</div><div class="small text-muted">@titulo</div></div>
                </div>
            </div>
        </div>
    }
</div>

@{ var lista = Filtradas.ToList(); }

<div class="card entrar" style="--i: 4;">
    <div class="card-header py-3">
        <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <div class="position-relative flex-grow-1" style="max-width: 380px;">
                <i class="bi bi-search position-absolute text-muted" style="left: .8rem; top: 50%; transform: translateY(-50%);"></i>
                <input type="text" class="form-control ps-5" placeholder="Buscar por curso, tema o nombre"
                       @bind="busqueda" @bind:event="oninput" aria-label="Buscar sesión" />
            </div>
            <div class="segmento" style="max-width: 100%; overflow-x: auto; scrollbar-width: none;" role="group" aria-label="Filtrar por estado">
                @foreach (var f in Filtros)
                {
                    <button type="button" class="@(filtro == f ? "activo" : "")" @onclick="() => filtro = f">@f</button>
                }
            </div>
        </div>
    </div>

    @if (lista.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th class="ps-3">N.º</th>
                        <th>Curso</th>
                        <th>Fecha y hora</th>
                        <th>@(EsTutor ? "Estudiante" : "Tutor")</th>
                        <th>Estado</th>
                        <th>Calificación</th>
                        <th class="pe-3"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in lista)
                    {
                        <tr @key="s.Numero">
                            <td class="ps-3 fw-semibold">@s.Numero</td>
                            <td class="lh-sm"><div class="fw-semibold">@s.Curso</div><small class="text-muted">@s.Tema</small></td>
                            <td class="text-nowrap">@s.Fecha<br /><small class="text-muted">@s.Hora</small></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <Avatar Nombre="@Contraparte(s)" Tamano="sm" />
                                    <span>@Contraparte(s)</span>
                                </div>
                            </td>
                            <td><span class="badge @ClaseEstado(s.Estado)">@s.Estado</span></td>
                            <td class="text-nowrap">
                                @if (s.Puntaje is int p)
                                {
                                    <span class="estrellas" title="@p de 5">
                                        @for (var i = 1; i <= 5; i++)
                                        {
                                            <i class="bi @(i <= p ? "bi-star-fill" : "bi-star")"></i>
                                        }
                                    </span>
                                }
                                else if (s.Estado == "Realizada")
                                {
                                    <span class="small text-muted">Sin calificar</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="pe-3 text-end text-nowrap">
                                @if (!EsTutor && s.Estado == "Realizada" && s.Puntaje is null)
                                {
                                    <a class="btn btn-sm btn-primary me-1" href="/sesiones/calificar?sesion=@s.Numero">Calificar</a>
                                }
                                <a class="btn btn-sm btn-outline-primary" href="/sesiones/detalle">Ver detalle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer small text-muted">Mostrando @lista.Count de @Mias.Count() sesiones</div>
    }
    else
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
            <div class="fw-semibold">No hay sesiones con ese filtro</div>
            <small>Prueba con otra búsqueda o cambia el estado.</small>
        </div>
    }
</div>

@code {
    private record Sesion(int Numero, string Curso, string Tema, string Fecha, string Hora,
                          string Tutor, string Estudiante, string Estado, int? Puntaje = null);

    private static readonly string[] Filtros = ["Todas", "Programadas", "Realizadas", "Canceladas"];

    // Sesiones de ejemplo, de la más reciente a la más antigua. Cada persona ve las suyas, como tutor o como estudiante.
    private static readonly Sesion[] todas =
    [
        new(32, "Cálculo 1", "Integrales", "30/10/2026", "5:00 p. m.", "Andrés Villanueva", "Camila Torres", "Programada"),
        new(33, "Química General", "Estequiometría", "29/10/2026", "2:00 p. m.", "Rosa Huamán", "Lucía Ramos", "Programada"),
        new(31, "Cálculo 1", "Límites y continuidad", "27/10/2026", "4:00 p. m.", "Andrés Villanueva", "Lucía Ramos", "Programada"),
        new(29, "Cálculo 1", "Derivadas", "23/10/2026", "4:00 p. m.", "Andrés Villanueva", "Lucía Ramos", "Realizada"),
        new(27, "Química General", "Enlaces químicos", "21/10/2026", "2:00 p. m.", "Rosa Huamán", "Lucía Ramos", "Realizada", 5),
        new(26, "Física 1", "Cinemática", "19/10/2026", "6:00 p. m.", "Jorge Salazar", "Lucía Ramos", "Cancelada por inasistencia"),
        new(28, "Cálculo 1", "Regla de la cadena", "17/10/2026", "5:00 p. m.", "Andrés Villanueva", "Diego Paredes", "Cancelada"),
        new(22, "Física 1", "Leyes de Newton", "11/10/2026", "6:00 p. m.", "Jorge Salazar", "Lucía Ramos", "Realizada", 3),
        new(25, "Cálculo 1", "Límites y continuidad", "10/10/2026", "3:00 p. m.", "Andrés Villanueva", "Camila Torres", "Realizada", 5),
        new(18, "Cálculo 1", "Regla de la cadena", "02/10/2026", "4:00 p. m.", "Andrés Villanueva", "Lucía Ramos", "Realizada", 4),
    ];

    private string busqueda = "";
    private string filtro = "Todas";

    private bool EsTutor => RolActual.Rol == RolActual.Tutor;

    private IEnumerable<Sesion> Mias =>
        todas.Where(s => (EsTutor ? s.Tutor : s.Estudiante) == RolActual.NombreUsuario);

    private IEnumerable<Sesion> Filtradas => Mias.Where(CumpleFiltro).Where(CumpleBusqueda);

    private bool CumpleFiltro(Sesion s) => filtro switch
    {
        "Programadas" => s.Estado == "Programada",
        "Realizadas" => s.Estado == "Realizada",
        "Canceladas" => s.Estado.StartsWith("Cancelada"),
        _ => true,
    };

    // Ignora mayúsculas y tildes: "calculo" encuentra "Cálculo"
    private bool CumpleBusqueda(Sesion s) =>
        string.IsNullOrWhiteSpace(busqueda)
        || new[] { s.Numero.ToString(), s.Curso, s.Tema, Contraparte(s) }.Any(t => Contiene(t, busqueda.Trim()));

    private static bool Contiene(string texto, string buscado) =>
        System.Globalization.CultureInfo.InvariantCulture.CompareInfo.IndexOf(texto, buscado,
            System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace) >= 0;

    private string Contraparte(Sesion s) => EsTutor ? s.Estudiante : s.Tutor;

    private (string, string, string)[] Resumen =>
    [
        ("Programadas", Mias.Count(s => s.Estado == "Programada").ToString(), "bi-calendar-event"),
        ("Realizadas", Mias.Count(s => s.Estado == "Realizada").ToString(), "bi-check-circle"),
        ("Canceladas", Mias.Count(s => s.Estado.StartsWith("Cancelada")).ToString(), "bi-x-circle"),
        EsTutor
            ? ("Calificación promedio", Promedio, "bi-star")
            : ("Por calificar", Mias.Count(s => s.Estado == "Realizada" && s.Puntaje is null).ToString(), "bi-star"),
    ];

    private string Promedio
    {
        get
        {
            var notas = Mias.Where(s => s.Puntaje is not null).Select(s => s.Puntaje!.Value).ToList();
            return notas.Count == 0 ? "—" : notas.Average().ToString("0.0");
        }
    }

    private static string ClaseEstado(string estado) => estado switch
    {
        "Programada" => "text-bg-primary",
        "En curso" => "text-bg-warning",
        "Realizada" => "text-bg-success",
        "Cancelada por inasistencia" => "text-bg-danger",
        _ => "text-bg-secondary",
    };

    protected override void OnInitialized() => RolActual.Cambio += AlCambiarRol;

    private void AlCambiarRol() => InvokeAsync(() =>
    {
        busqueda = "";
        filtro = "Todas";
        StateHasChanged();
    });

    public void Dispose() => RolActual.Cambio -= AlCambiarRol;
}
