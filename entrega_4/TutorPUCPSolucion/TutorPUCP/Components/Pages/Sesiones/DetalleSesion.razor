@page "/sesiones/detalle"
@implements IDisposable
@inject RolActual RolActual

@* Requisitos: RF012 check-in/check-out, RF013 cancelar, RF014 calificar, RF015 reclamar *@
@* Solo visual: los check-in y check-out se simulan en pantalla, no se guardan en la base de datos *@

<PageTitle>Detalle de sesión</PageTitle>

<Toasts class="p-3" Messages="avisos" AutoHide="true" Delay="4000" Placement="ToastsPlacement.TopRight" />

<a href="/sesiones" class="small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Volver a mis sesiones</a>

<div class="titulo-pagina mt-2">
    <div class="d-flex align-items-center gap-3">
        <span class="icono-titulo" style="background:#dbeafe;color:#2563eb;"><i class="bi bi-calendar-check-fill"></i></span>
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h1 class="h3 mb-0">Cálculo 1 · Límites y continuidad</h1>
                <span class="badge @ClaseEstado" @key="estado" style="animation: tpAparecer .4s ease both;">@estado</span>
            </div>
            <p>Sesión N.º 31 · martes 27/10/2026, de 4:00 p. m. a 5:00 p. m.</p>
        </div>
    </div>
    <a class="btn btn-primary" href="/mensajes/conversacion"><i class="bi bi-chat-dots me-1"></i> Enviar mensaje</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        @* Ciclo de vida de la sesión *@
        <div class="card mb-4 entrar" style="--i: 0;">
            <div class="card-body">
                <h2 class="h5 mb-3"><i class="bi bi-signpost-split me-2 text-primary"></i>Estado de la sesión</h2>
                @if (Cancelada)
                {
                    <div class="nota nota-error d-flex gap-3" style="animation: tpAparecer .4s ease backwards;">
                        <i class="bi bi-x-octagon-fill fs-4"></i>
                        <div>
                            <div class="fw-bold">@estado</div>
                            <div class="small">@motivoCancelacion</div>
                        </div>
                    </div>
                }
                else
                {
                    <Pasos Etapas="Etapas" Actual="PasoActual" />
                    <p class="small text-muted mt-3 mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        @(estado switch
                        {
                            "Programada" => "Cuando los dos registren su check-in, la sesión pasa a En curso. Si pasan 15 minutos sin ambos check-in, se cancela por inasistencia.",
                            "En curso" => "Cuando los dos registren su check-out, la sesión queda Realizada.",
                            _ => "La sesión terminó. El estudiante ya puede calificar al tutor.",
                        })
                    </p>
                }
            </div>
        </div>

        @* Asistencia: cada uno registra su propio check-in y check-out *@
        <div class="card mb-4 entrar" style="--i: 1;">
            <div class="card-body">
                <h2 class="h5 mb-3"><i class="bi bi-person-check me-2 text-primary"></i>Asistencia</h2>
                <div class="row g-3">
                    @foreach (var p in new[] { yo, otro })
                    {
                        <div class="col-md-6">
                            <div class="caja-suave rounded-4 p-3 h-100">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <Avatar Nombre="@p.Nombre" Tamano="sm" />
                                    <div>
                                        <div class="fw-semibold">@p.Nombre @(p == yo ? "(tú)" : "")</div>
                                        <div class="small text-muted">@p.Rol</div>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between small py-1">
                                    <span><i class="bi bi-box-arrow-in-right me-1"></i>Check-in</span>
                                    <span class="@(p.CheckIn is null ? "text-muted" : "fw-semibold text-success")">@(p.CheckIn ?? "Pendiente")</span>
                                </div>
                                <div class="d-flex justify-content-between small py-1">
                                    <span><i class="bi bi-box-arrow-right me-1"></i>Check-out</span>
                                    <span class="@(p.CheckOut is null ? "text-muted" : "fw-semibold text-success")">@(p.CheckOut ?? "Pendiente")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex flex-wrap gap-2 mt-3">
                    @if (esperando)
                    {
                        <span class="small text-muted d-flex align-items-center gap-2">
                            <span class="spinner-border spinner-border-sm text-primary"></span> Esperando a @otro.Nombre…
                        </span>
                    }
                    else if (estado == "Programada" && yo.CheckIn is null)
                    {
                        <button class="btn btn-primary" @onclick="HacerCheckIn"><i class="bi bi-box-arrow-in-right me-1"></i> Registrar mi check-in</button>
                    }
                    else if (estado == "En curso" && yo.CheckOut is null)
                    {
                        <button class="btn btn-primary" @onclick="HacerCheckOut"><i class="bi bi-box-arrow-right me-1"></i> Registrar mi check-out</button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4 entrar" style="--i: 2;">
            <div class="card-body">
                <h2 class="h5 mb-3"><i class="bi bi-card-list me-2 text-primary"></i>Datos de la sesión</h2>
                @foreach (var (icono, etiqueta, valor) in Datos)
                {
                    <div class="d-flex gap-2 py-2">
                        <i class="bi @icono text-primary"></i>
                        <div>
                            <div class="small text-muted">@etiqueta</div>
                            <div class="fw-semibold">@valor</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card entrar" style="--i: 3;">
            <div class="card-body d-grid gap-2">
                <h2 class="h5 mb-1"><i class="bi bi-lightning-charge me-2 text-primary"></i>Acciones</h2>

                @if (RolActual.Rol == RolActual.Estudiante)
                {
                    <a class="btn btn-primary @(estado == "Realizada" ? "" : "disabled")" href="/sesiones/calificar">
                        <i class="bi bi-star me-1"></i> Calificar al tutor
                    </a>
                }
                <a class="btn btn-outline-danger @(PuedeReclamar ? "" : "disabled")" href="/reclamos/nuevo?abrir=true">
                    <i class="bi bi-flag me-1"></i> Registrar reclamo
                </a>
                <button class="btn btn-outline-secondary" disabled="@(!PuedeCancelar)" @onclick="() => modalCancelar.ShowAsync()">
                    <i class="bi bi-x-circle me-1"></i> Cancelar sesión
                </button>

                <div class="small text-muted mt-1">
                    @if (estado == "Programada" && !PuedeCancelar)
                    {
                        <span>Ya no se puede cancelar porque alguien registró su check-in.</span>
                    }
                    else if (!PuedeReclamar)
                    {
                        <span>El reclamo se habilita cuando la sesión termina o se cancela por inasistencia.</span>
                    }
                </div>

                <hr class="my-2" />
                <div class="small text-muted">Solo para la demostración:</div>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-sm btn-light" disabled="@(estado != "Programada" || esperando)" @onclick="SimularInasistencia">
                        <i class="bi bi-hourglass-bottom me-1"></i> Pasaron 15 min
                    </button>
                    <button class="btn btn-sm btn-light" @onclick="Reiniciar"><i class="bi bi-arrow-counterclockwise me-1"></i> Reiniciar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@* Cancelar solo mientras está Programada, con motivo obligatorio (RF013) *@
<Modal @ref="modalCancelar" Title="Cancelar sesión" IsVerticallyCentered="true">
    <BodyTemplate>
        <p class="mb-2">Cuéntale a @otro.Nombre por qué se cancela la sesión.</p>
        <textarea class="form-control" rows="3" maxlength="255" placeholder="Motivo de la cancelación"
                  @bind="motivo" @bind:event="oninput"></textarea>
        <div class="d-flex justify-content-between small mt-1">
            <span class="text-danger">@(DatosContacto.Contiene(motivo) ? "No escribas correos ni teléfonos." : "")</span>
            <span class="text-muted">@motivo.Length/255</span>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => modalCancelar.HideAsync()">Volver</button>
        <button type="button" class="btn btn-danger" disabled="@(!MotivoValido)" @onclick="Cancelar">Cancelar sesión</button>
    </FooterTemplate>
</Modal>

@code {
    private class Persona
    {
        public required string Nombre { get; init; }
        public required string Rol { get; init; }
        public string? CheckIn { get; set; }
        public string? CheckOut { get; set; }
    }

    private static readonly string[] Etapas = ["Programada", "En curso", "Realizada"];

    private Modal modalCancelar = default!;
    private readonly List<ToastMessage> avisos = [];

    private string estado = "Programada";
    private string motivo = "";
    private string motivoCancelacion = "";
    private bool esperando;
    private int vuelta; // evita que una espera vieja cambie el estado después de "Reiniciar"
    private Persona yo = default!;
    private Persona otro = default!;

    private bool Cancelada => estado.StartsWith("Cancelada");
    private bool PuedeCancelar => estado == "Programada" && yo.CheckIn is null && otro.CheckIn is null;
    private bool PuedeReclamar => estado is "Realizada" or "Cancelada por inasistencia";
    private bool MotivoValido => !string.IsNullOrWhiteSpace(motivo) && !DatosContacto.Contiene(motivo);

    private int PasoActual => estado switch { "Programada" => 0, "En curso" => 1, _ => 3 };

    private string ClaseEstado => estado switch
    {
        "Programada" => "text-bg-primary",
        "En curso" => "text-bg-warning",
        "Realizada" => "text-bg-success",
        _ => "text-bg-danger",
    };

    private static IEnumerable<(string, string, string)> Datos =>
    [
        ("bi-book", "Curso", "Cálculo 1"),
        ("bi-bookmark", "Tema", "Límites y continuidad"),
        ("bi-calendar-event", "Fecha y hora", "27/10/2026 · 4:00 p. m."),
        ("bi-clock", "Duración", "1 hora"),
        ("bi-person-workspace", "Tutor", "Andrés Villanueva"),
        ("bi-backpack2", "Estudiante", "Lucía Ramos"),
        ("bi-cash-coin", "Tarifa", "S/ 35.00 por hora"),
    ];

    protected override void OnInitialized()
    {
        Reiniciar();
        RolActual.Cambio += AlCambiarRol;
    }

    private void AlCambiarRol() => InvokeAsync(() => { Reiniciar(); StateHasChanged(); });

    private void Reiniciar()
    {
        vuelta++;
        var tutor = new Persona { Nombre = "Andrés Villanueva", Rol = RolActual.Tutor };
        var estudiante = new Persona { Nombre = "Lucía Ramos", Rol = RolActual.Estudiante };
        (yo, otro) = RolActual.Rol == RolActual.Tutor ? (tutor, estudiante) : (estudiante, tutor);
        estado = "Programada";
        motivo = motivoCancelacion = "";
        esperando = false;
    }

    private static string Ahora => DateTime.Now.ToString("HH:mm");

    private async Task HacerCheckIn()
    {
        yo.CheckIn = Ahora;
        Avisar(ToastType.Success, "Check-in registrado", "Falta el check-in de " + otro.Nombre + ".");
        await EsperarAlOtro(() => otro.CheckIn = Ahora, "En curso", "registró su check-in. La sesión está en curso.");
    }

    private async Task HacerCheckOut()
    {
        yo.CheckOut = Ahora;
        Avisar(ToastType.Success, "Check-out registrado", "Falta el check-out de " + otro.Nombre + ".");
        await EsperarAlOtro(() => otro.CheckOut = Ahora, "Realizada", "registró su check-out. La sesión quedó realizada.");
    }

    // Simula que la otra persona marca desde su propio dispositivo un momento después
    private async Task EsperarAlOtro(Action marcar, string nuevoEstado, string texto)
    {
        var miVuelta = vuelta;
        esperando = true;
        StateHasChanged();
        await Task.Delay(1800);
        if (miVuelta != vuelta) return;
        marcar();
        estado = nuevoEstado;
        esperando = false;
        Avisar(ToastType.Info, nuevoEstado, otro.Nombre + " " + texto);
    }

    private void SimularInasistencia()
    {
        estado = "Cancelada por inasistencia";
        motivoCancelacion = "Pasaron 15 minutos desde las 4:00 p. m. sin que ambos registraran su check-in. Ya se puede registrar un reclamo.";
        Avisar(ToastType.Danger, "Sesión cancelada", "Se canceló por inasistencia.");
    }

    private async Task Cancelar()
    {
        estado = "Cancelada";
        motivoCancelacion = "Cancelada por " + yo.Nombre + ": " + motivo.Trim();
        await modalCancelar.HideAsync();
        Avisar(ToastType.Warning, "Sesión cancelada", otro.Nombre + " recibirá el motivo.");
    }

    private void Avisar(ToastType tipo, string titulo, string texto) =>
        avisos.Add(new ToastMessage { Type = tipo, Title = titulo, Message = texto });

    public void Dispose() => RolActual.Cambio -= AlCambiarRol;
}
