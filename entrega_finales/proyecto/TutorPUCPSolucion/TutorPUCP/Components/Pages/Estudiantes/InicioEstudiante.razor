@page "/estudiante"
@implements IDisposable
@inject RolActual RolActual
@inject SesionRestService Rest

@* Las sesiones salen de la BD a través del servicio REST (GET sesion/usuario/{id}).
   "Mensajes sin leer" todavía es un dato de ejemplo. *@

<PageTitle>Inicio estudiante</PageTitle>

<div class="titulo-pagina">
    <div class="d-flex align-items-center gap-3">
        <span class="icono-titulo"><i class="bi bi-house-door-fill"></i></span>
        <div>
            <h1 class="h3">Hola, @PrimerNombre</h1>
            <p>Busca un tutor, coordina tu sesión y revisa tus tutorías.</p>
        </div>
    </div>
    <a class="btn btn-primary" href="/estudiante/buscar-tutores"><i class="bi bi-compass me-1"></i>Buscar tutores</a>
</div>

@* Sesión realizada que todavía no se calificó (RF014) *@
@if (PorCalificar is { } pendiente)
{
    <div class="nota d-flex flex-wrap align-items-center gap-3 mb-4">
        <i class="bi bi-star fs-4 text-primary"></i>
        <div class="flex-grow-1 lh-sm">
            <div class="fw-semibold">Ya puedes calificar tu sesión con @pendiente.Tutor</div>
            <small class="text-muted">@pendiente.Curso · @pendiente.TemasTexto · @pendiente.FechaTexto</small>
        </div>
        <a class="btn btn-primary btn-sm" href="/sesiones/calificar?id=@pendiente.IdSesion">Calificar</a>
    </div>
}

<div class="row g-3 mb-4">
    @{ var k = 0; }
    @foreach (var (href, titulo, valor, icono) in Resumen)
    {
        <div class="col-6 col-lg-3 entrar" style="--i: @(k++);">
            <a class="card kpi tarjeta-hover h-100 text-decoration-none" href="@href">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="kpi-icono"><i class="bi @icono"></i></span>
                    <div><div class="kpi-valor">@valor</div><div class="small text-muted">@titulo</div></div>
                </div>
            </a>
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card h-100 entrar" style="--i: 4;">
            <div class="card-header py-3 d-flex align-items-center justify-content-between">
                <h2 class="h5 mb-0"><i class="bi bi-calendar-event me-2 text-primary"></i>Próximas sesiones</h2>
                <a class="small text-decoration-none" href="/sesiones">Ver todas <i class="bi bi-arrow-right"></i></a>
            </div>
            @if (Yo is null)
            {
                <div class="estado-vacio">
                    <i class="bi bi-person-lock"></i>
                    <div class="fw-semibold">Inicia sesión para ver tus sesiones</div>
                    <a class="btn btn-outline-primary btn-sm mt-2" href="/login/usuario">Iniciar sesión</a>
                </div>
            }
            else if (cargando)
            {
                <div class="estado-vacio">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="small mt-2">Cargando tus sesiones...</div>
                </div>
            }
            else if (error is not null)
            {
                <div class="estado-vacio">
                    <i class="bi bi-wifi-off"></i>
                    <div class="fw-semibold">No se pudieron cargar tus sesiones</div>
                    <div class="small">@error</div>
                    <button type="button" class="btn btn-outline-primary btn-sm mt-2" @onclick="Cargar">Reintentar</button>
                </div>
            }
            else if (Proximas.Count == 0)
            {
                <div class="estado-vacio">
                    <i class="bi bi-calendar-x"></i>
                    <div class="fw-semibold">No tienes sesiones próximas</div>
                    <a class="btn btn-outline-primary btn-sm mt-2" href="/estudiante/buscar-tutores">Buscar tutores</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-primary">
                            <tr>
                                <th class="ps-3">Tutor</th>
                                <th>Curso</th>
                                <th>Fecha y hora</th>
                                <th class="pe-3"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Proximas)
                            {
                                <tr @key="s.IdSesion">
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <Avatar Nombre="@s.Tutor" Tamano="sm" />
                                            <span class="fw-semibold">@s.Tutor</span>
                                        </div>
                                    </td>
                                    <td class="lh-sm"><div>@s.Curso</div><small class="text-muted">@s.TemasTexto</small></td>
                                    <td class="text-nowrap">@s.FechaTexto<br /><small class="text-muted">@s.HoraTexto</small></td>
                                    <td class="pe-3 text-end"><a class="btn btn-sm btn-outline-primary" href="/sesiones/detalle?id=@s.IdSesion">Ver detalle</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100 entrar" style="--i: 5;">
            <div class="card-body">
                <h2 class="h5 mb-3"><i class="bi bi-lightning-charge me-2 text-primary"></i>Accesos rápidos</h2>
                <div class="d-grid gap-2">
                    @foreach (var (href, icono, texto, detalle) in accesos)
                    {
                        <a class="d-flex align-items-center gap-3 p-3 rounded-4 caja-suave tarjeta-hover text-decoration-none text-body" href="@href">
                            <i class="bi @icono fs-5 text-primary"></i>
                            <span class="lh-sm">
                                <span class="d-block fw-semibold">@texto</span>
                                <small class="text-muted">@detalle</small>
                            </span>
                            <i class="bi bi-chevron-right ms-auto text-muted"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Cuántas sesiones se muestran en "Próximas sesiones" (las demás están en "Mis sesiones")
    private const int MaxProximas = 5;

    private static readonly (string, string, string, string)[] accesos =
    [
        ("/estudiante/buscar-tutores", "bi-compass", "Buscar tutores", "Por curso, tarifa y calificación"),
        ("/sesiones", "bi-calendar-week", "Mis sesiones", "Check-in, calificación y reclamos"),
        ("/mensajes", "bi-chat-dots", "Mensajes", "Coordina con tus tutores"),
        ("/reclamos/nuevo", "bi-flag", "Reclamos", "Si algo salió mal en una sesión"),
    ];

    // null = todavía no llega la respuesta del servicio
    private List<SesionRestDTO>? sesiones;
    private bool cargando = true;
    private string? error;

    private UsuarioDto? Yo => RolActual.Usuario;

    private string PrimerNombre => RolActual.PrimerNombre;

    // Aquí solo cuentan las sesiones que recibo como estudiante
    private List<SesionRestDTO> Mias =>
        (sesiones ?? []).Where(s => s.IdEstudiante == Yo?.IdUsuario).ToList();

    private static bool EsProgramada(SesionRestDTO s) => s.Estado is "PROGRAMADA" or "EN_CURSO";

    private static bool SinCalificar(SesionRestDTO s) => s.Estado == "REALIZADA" && s.Puntaje is null;

    private List<SesionRestDTO> Proximas => SesionRestDTO.Proximas(Mias, MaxProximas);

    // La última sesión realizada que todavía no se calificó
    private SesionRestDTO? PorCalificar => Mias.Where(SinCalificar).OrderByDescending(s => s.Inicio).FirstOrDefault();

    private (string, string, string, string)[] Resumen
    {
        get
        {
            var mias = Mias;
            var cargado = sesiones is not null;
            string N(int n) => cargado ? n.ToString() : "—";
            return
            [
                ("/sesiones", "Próximas sesiones", N(mias.Count(EsProgramada)), "bi-calendar-event"),
                ("/sesiones", "Sesiones realizadas", N(mias.Count(s => s.Estado == "REALIZADA")), "bi-check-circle"),
                (PorCalificar is { } p ? $"/sesiones/calificar?id={p.IdSesion}" : "/sesiones", "Por calificar", N(mias.Count(SinCalificar)), "bi-star"),
                ("/mensajes", "Mensajes sin leer", "2", "bi-chat-dots"),   // dato de ejemplo
            ];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        RolActual.Cambio += AlCambiarRol;
        await Cargar();
    }

    private async Task Cargar()
    {
        if (Yo is null)
        {
            cargando = false;
            return;
        }
        cargando = true;
        error = null;
        try
        {
            sesiones = await Rest.ListarDeUsuarioAsync(Yo.IdUsuario);
        }
        catch (Exception ex)
        {
            error = AcademicoRestService.MensajeDeError(ex);
        }
        finally
        {
            cargando = false;
        }
    }

    private void AlCambiarRol() => InvokeAsync(StateHasChanged);

    public void Dispose() => RolActual.Cambio -= AlCambiarRol;
}
