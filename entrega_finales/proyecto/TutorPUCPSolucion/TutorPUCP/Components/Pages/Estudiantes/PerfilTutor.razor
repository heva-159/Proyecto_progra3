@page "/estudiante/tutor"
@using System.Globalization
@using TutorPUCP.Servicios
@inject AcademicoApi Api
@inject RolActual RolActual

@* Requisito: RF009. Es el perfil del tutor que el estudiante eligió en la búsqueda; se abre con ?id=5 (el id del tutor).
   Los datos vienen de la BD a través del servicio REST (GET academico/tutores/{id}/perfil). No se muestran correo ni
   teléfono: la coordinación se hace por la mensajería interna (RNF005). *@

<PageTitle>Perfil del tutor</PageTitle>

@* Botón de navegación para volver al catálogo de búsqueda *@
<div class="mb-3">
    <a href="/estudiante/buscar-tutores" class="btn btn-outline-secondary btn-sm">
        ← Volver a la Búsqueda de Tutores
    </a>
</div>

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="text-muted mt-2">Cargando el perfil del tutor...</p>
    </div>
}
else if (error is not null)
{
    <div class="card border-0 bg-white p-5 text-center shadow-sm mb-4">
        <i class="bi bi-wifi-off fs-1 text-muted mb-2"></i>
        <h5 class="fw-bold text-secondary">No se pudo cargar el perfil</h5>
        <p class="text-muted mb-3">@error</p>
        <div>
            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="Cargar">Reintentar</button>
        </div>
    </div>
}
else if (perfil is null)
{
    <div class="card border-0 bg-white p-5 text-center shadow-sm mb-4">
        <i class="bi bi-person-x fs-1 text-muted mb-2"></i>
        <h5 class="fw-bold text-secondary">Elige un tutor</h5>
        <p class="text-muted mb-3">Abre el perfil desde la <a href="/estudiante/buscar-tutores">búsqueda de tutores</a>.</p>
    </div>
}
else
{
    @* =============================================================================
       TARJETA PRINCIPAL DEL PERFIL DEL TUTOR
       Cabecera con avatar grande, facultad, promedio de calificaciones y botón de mensaje.
       ============================================================================= *@
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">

                @* Avatar y datos del tutor *@
                <div class="d-flex align-items-center gap-3">
                    <Avatar Nombre="@perfil.Nombre" Tamano="lg" />
                    <div>
                        <h3 class="fw-bold text-dark mb-1">@perfil.Nombre</h3>
                        <p class="text-muted mb-2">@FacultadYEspecialidad</p>
                        <div class="d-flex flex-wrap gap-2">
                            @if (perfil.Calificacion is double promedio)
                            {
                                <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-star-fill"></i> @promedio.ToString("0.0", Peru) de promedio</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border px-2 py-1">Aún sin calificaciones</span>
                            }
                            <span class="badge bg-info text-dark px-2 py-1">@TextoTutorias</span>
                            @if (perfil.CorreoVerificado)
                            {
                                <span class="badge bg-success px-2 py-1"><i class="bi bi-check-lg"></i> Cuenta verificada PUCP</span>
                            }
                        </div>
                    </div>
                </div>

                @* Acción para el estudiante: coordinar por la mensajería interna (el tutor registra la sesión después) *@
                <div class="d-flex flex-column gap-2 text-md-end">
                    @if (EsElMismoTutor)
                    {
                        <span class="small text-muted">Así ven tu perfil los estudiantes.</span>
                    }
                    else if (Yo is null)
                    {
                        <a href="/login/usuario" class="btn btn-outline-primary shadow-sm">Inicia sesión para escribirle</a>
                    }
                    else
                    {
                        <a href="/mensajes/conversacion/@perfil.IdTutor" class="btn btn-primary shadow-sm">
                            <i class="bi bi-chat-dots me-1"></i>Enviar mensaje al tutor
                        </a>
                    }
                </div>
            </div>
            <div class="small text-muted mt-3">
                <i class="bi bi-shield-check me-1"></i>Por privacidad no se muestran el correo ni el teléfono del tutor: la coordinación se hace por mensajes dentro de la plataforma.
            </div>
        </div>
    </div>

    @* =============================================================================
       CURSOS ACREDITADOS Y TARIFAS POR HORA
       Los cursos en los que tiene postulación aprobada y cuánto cobra en cada uno.
       ============================================================================= *@
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold mb-0 text-dark">Cursos Acreditados y Tarifas</h5>
        </div>
        <div class="card-body p-0">
            @if (perfil.Cursos.Count == 0)
            {
                <div class="p-4 text-muted">Este tutor todavía no tiene cursos con postulación aprobada.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Código</th>
                                <th>Nombre del Curso</th>
                                <th>Temas del curso</th>
                                <th>Tarifa por Hora</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var curso in perfil.Cursos)
                            {
                                <tr @key="curso.IdCurso">
                                    <td class="ps-3 fw-bold text-muted">@curso.Codigo</td>
                                    <td class="fw-semibold text-dark">@curso.Nombre</td>
                                    <td class="text-muted small">@(curso.Temas.Count == 0 ? "—" : string.Join(", ", curso.Temas))</td>
                                    <td>
                                        @if (curso.TarifaPorHora is decimal tarifa)
                                        {
                                            <span class="text-success fw-bold fs-6">S/ @tarifa.ToString("0.00", Peru)</span>
                                            <small class="text-muted">/ hora</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Por definir</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* =============================================================================
       CALIFICACIONES DE LOS ALUMNOS
       Prueba social: lo que calificaron los estudiantes que ya tomaron sesiones con él (sin su nombre).
       ============================================================================= *@
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">Calificaciones de Alumnos (@perfil.CantidadCalificaciones)</h5>
            @if (perfil.Calificacion is double promedioGeneral)
            {
                <span class="text-warning fw-bold"><i class="bi bi-star-fill"></i> @promedioGeneral.ToString("0.0", Peru) sobre 5.0</span>
            }
        </div>
        <div class="card-body p-4 pt-2">
            @if (perfil.Resenas.Count == 0)
            {
                <p class="text-muted mb-0">Todavía no tiene calificaciones.</p>
            }
            else
            {
                @foreach (var r in perfil.Resenas)
                {
                    <div class="border-bottom py-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-warning">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= r.Puntaje ? "bi-star-fill" : "bi-star")"></i>
                                }
                            </span>
                            <span class="text-muted small">@Fecha(r.Fecha)</span>
                        </div>
                        <span class="badge bg-light text-muted border mb-2">Curso: @r.CodigoCurso - @r.Curso</span>
                        @if (!string.IsNullOrWhiteSpace(r.Comentario))
                        {
                            <p class="text-muted mb-0 small fst-italic">"@r.Comentario"</p>
                        }
                    </div>
                }
                @if (perfil.CantidadCalificaciones > perfil.Resenas.Count)
                {
                    <p class="small text-muted mt-3 mb-0">Se muestran las @perfil.Resenas.Count calificaciones más recientes.</p>
                }
            }
        </div>
    </div>
}

@code {
    private static readonly CultureInfo Peru = new("es-PE");

    // Viene en la URL: /estudiante/tutor?id=5 (el id del tutor, que es también su id de usuario)
    [SupplyParameterFromQuery(Name = "id")] public int? Id { get; set; }

    private PerfilTutorDto? perfil;
    private bool cargando = true;
    private string? error;

    private UsuarioDto? Yo => RolActual.Usuario;

    private bool EsElMismoTutor => perfil is not null && Yo?.IdUsuario == perfil.IdTutor;

    // "Facultad de Ciencias e Ingeniería | Ingeniería Informática"; si no hay datos, "Estudiante PUCP"
    private string FacultadYEspecialidad
    {
        get
        {
            var partes = new[] { perfil?.Facultad, perfil?.Especialidad }.Where(p => !string.IsNullOrWhiteSpace(p));
            return partes.Any() ? string.Join(" | ", partes) : "Estudiante PUCP";
        }
    }

    private string TextoTutorias => perfil?.SesionesDictadas == 1 ? "1 tutoría dictada" : $"{perfil?.SesionesDictadas ?? 0} tutorías dictadas";

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        perfil = null;
        error = null;
        if (Id is not int id || id <= 0)
        {
            cargando = false;
            return;
        }
        cargando = true;
        var (resultado, fallo) = await Api.ObtenerPerfilTutorAsync(id);
        perfil = resultado;
        error = fallo;
        cargando = false;
    }

    // "17/11/2026" (RNF006: fecha DD/MM/AAAA)
    private static string Fecha(string? texto) =>
        DateTime.TryParse(texto, CultureInfo.InvariantCulture, DateTimeStyles.None, out var f)
            ? f.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)
            : "";
}
