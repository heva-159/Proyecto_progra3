@page "/admin/usuarios"
@inject UsuariosApi Api

@* Requisito: RF019. El administrador bloquea y reactiva cuentas de usuario (GestorUsuariosRecurso). *@

<PageTitle>Usuarios</PageTitle>

<Toasts class="p-3" Messages="avisos" AutoHide="true" Delay="4500" Placement="ToastsPlacement.TopRight" />
<ModalListo @ref="listo" />

<div class="titulo-pagina">
    <div class="d-flex align-items-center gap-3">
        <span class="icono-titulo" style="background:#fef3c7;color:#b45309;"><i class="bi bi-people-fill"></i></span>
        <div>
            <h1 class="h3">Usuarios</h1>
            <p>Bloquea las cuentas que incumplan las normas o reactiva las que estaban bloqueadas.</p>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3 entrar" style="--i: 0;">
        <div class="card kpi h-100"><div class="card-body d-flex align-items-center gap-3">
            <span class="kpi-icono" style="background:#dbeafe;color:#1d4ed8;"><i class="bi bi-people"></i></span>
            <div><div class="kpi-valor">@usuarios.Count</div><div class="small text-muted">Cuentas</div></div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3 entrar" style="--i: 1;">
        <div class="card kpi h-100"><div class="card-body d-flex align-items-center gap-3">
            <span class="kpi-icono" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-person-check"></i></span>
            <div><div class="kpi-valor">@usuarios.Count(EstaActiva)</div><div class="small text-muted">Activas</div></div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3 entrar" style="--i: 2;">
        <div class="card kpi h-100"><div class="card-body d-flex align-items-center gap-3">
            <span class="kpi-icono" style="background:#fee2e2;color:#dc2626;"><i class="bi bi-person-lock"></i></span>
            <div><div class="kpi-valor">@usuarios.Count(u => !EstaActiva(u))</div><div class="small text-muted">Bloqueadas</div></div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3 entrar" style="--i: 3;">
        <div class="card kpi h-100"><div class="card-body d-flex align-items-center gap-3">
            <span class="kpi-icono" style="background:#f1f5f9;color:#475569;"><i class="bi bi-envelope-exclamation"></i></span>
            <div><div class="kpi-valor">@usuarios.Count(u => !u.CorreoVerificado)</div><div class="small text-muted">Sin verificar</div></div>
        </div></div>
    </div>
</div>

<div class="card">
    <div class="card-header py-3">
        <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <div class="position-relative flex-grow-1" style="max-width: 340px;">
                <i class="bi bi-search position-absolute text-muted" style="left: .8rem; top: 50%; transform: translateY(-50%);"></i>
                <input type="text" class="form-control ps-5" placeholder="Nombre, código o correo" aria-label="Buscar"
                       @bind="busqueda" @bind:event="oninput" />
            </div>
            <div class="segmento" role="group" aria-label="Estado de la cuenta">
                @foreach (var e in new[] { "Todas", "Activas", "Bloqueadas" })
                {
                    <button type="button" class="@(filtro == e ? "activo" : "")" @onclick="() => filtro = e">@e</button>
                }
            </div>
        </div>
    </div>

    @if (cargando)
    {
        <div class="estado-vacio">
            <div class="spinner-border text-primary mb-2" role="status"></div>
            <div class="fw-semibold">Cargando usuarios...</div>
        </div>
    }
    else if (errorCarga is not null)
    {
        <div class="estado-vacio">
            <i class="bi bi-wifi-off"></i>
            <div class="fw-semibold">No se pudieron cargar los usuarios</div>
            <div class="small">@errorCarga</div>
        </div>
    }
    else if (Filtrados.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th class="ps-3">Usuario</th>
                        <th>Código</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var i = 0; }
                    @foreach (var u in Filtrados)
                    {
                        <tr class="entrar" style="--i: @(i++);" @key="u.IdUsuario">
                            <td class="ps-3">
                                <div class="fw-semibold">@u.Nombres @u.Apellidos</div>
                                <div class="small text-muted">@u.CorreoInstitucional</div>
                            </td>
                            <td class="fw-bold">@u.CodigoPucp</td>
                            <td><span class="badge etiqueta">@RolTexto(u.Rol)</span></td>
                            <td>
                                <span class="badge @(EstaActiva(u) ? "text-bg-success" : "text-bg-danger")">@(EstaActiva(u) ? "Activa" : "Bloqueada")</span>
                                @if (!u.CorreoVerificado)
                                {
                                    <span class="badge text-bg-light ms-1">Sin verificar</span>
                                }
                            </td>
                            <td class="text-end pe-3 text-nowrap">
                                @if (EstaActiva(u))
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => AbrirCambio(u)">
                                        <i class="bi bi-lock me-1"></i>Bloquear
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-success btn-sm" @onclick="() => AbrirCambio(u)">
                                        <i class="bi bi-unlock me-1"></i>Reactivar
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="estado-vacio">
            <i class="bi bi-search"></i>
            <div class="fw-semibold">Ningún usuario coincide con el filtro</div>
        </div>
    }
</div>

@* Confirmar bloquear o reactivar *@
<Modal @ref="modalConfirmar" Title="@(cambiando is not null && EstaActiva(cambiando) ? "Bloquear cuenta" : "Reactivar cuenta")" IsVerticallyCentered="true">
    <BodyTemplate>
        @if (cambiando is not null)
        {
            if (EstaActiva(cambiando))
            {
                <p class="mb-2">¿Bloquear la cuenta de <b>@cambiando.Nombres @cambiando.Apellidos</b> (@cambiando.CodigoPucp)?</p>
                <div class="nota nota-error small">
                    <i class="bi bi-exclamation-triangle me-1"></i>No podrá iniciar sesión hasta que la reactives.
                    Su historial de sesiones, calificaciones y reclamos se conserva.
                </div>
            }
            else
            {
                <p class="mb-2">¿Reactivar la cuenta de <b>@cambiando.Nombres @cambiando.Apellidos</b> (@cambiando.CodigoPucp)?</p>
                <div class="nota nota-ok small">Podrá volver a iniciar sesión y usar la plataforma con sus roles de siempre.</div>
            }
        }
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => modalConfirmar.HideAsync()">Cancelar</button>
        <button type="button" class="btn @(cambiando is not null && EstaActiva(cambiando) ? "btn-danger" : "btn-success")" disabled="@ocupado" @onclick="CambiarEstado">
            Sí, @(cambiando is not null && EstaActiva(cambiando) ? "bloquear" : "reactivar")
        </button>
    </FooterTemplate>
</Modal>

@code {
    private Modal modalConfirmar = default!;
    private ModalListo listo = default!;
    private readonly List<ToastMessage> avisos = [];

    private string busqueda = "";
    private string filtro = "Todas";

    private List<UsuarioDto> usuarios = [];
    private bool cargando = true;
    private string? errorCarga;
    private bool ocupado;
    private UsuarioDto? cambiando;

    protected override async Task OnInitializedAsync() => await Recargar();

    private async Task Recargar()
    {
        var (lista, error) = await Api.ListarUsuariosAsync();
        if (error is null) usuarios = lista ?? [];
        errorCarga = error;
        cargando = false;
    }

    private static bool EstaActiva(UsuarioDto u) => u.Estado.Equals("ACTIVA", StringComparison.OrdinalIgnoreCase);

    private static string RolTexto(string rol) => rol.ToUpperInvariant() switch
    {
        "TUTOR" => "Tutor",
        "ESTUDIANTE" => "Estudiante",
        "AMBOS" => "Estudiante y tutor",
        _ => rol
    };

    private IEnumerable<UsuarioDto> Filtrados => usuarios
        .Where(u => filtro == "Todas" || (filtro == "Activas") == EstaActiva(u))
        .Where(u => string.IsNullOrWhiteSpace(busqueda)
                    || $"{u.Nombres} {u.Apellidos}".Contains(busqueda, StringComparison.OrdinalIgnoreCase)
                    || u.CodigoPucp.Contains(busqueda, StringComparison.OrdinalIgnoreCase)
                    || u.CorreoInstitucional.Contains(busqueda, StringComparison.OrdinalIgnoreCase));

    private async Task AbrirCambio(UsuarioDto u)
    {
        cambiando = u;
        await modalConfirmar.ShowAsync();
    }

    // Bloquear (PUT /usuario/{id}/bloquear) o reactivar (PUT /usuario/{id}/reactivar)
    private async Task CambiarEstado()
    {
        if (ocupado || cambiando is null) return;
        ocupado = true;
        var u = cambiando;
        var bloquear = EstaActiva(u);
        await modalConfirmar.HideAsync();
        try
        {
            var (_, error) = bloquear ? await Api.BloquearUsuarioAsync(u.IdUsuario) : await Api.ReactivarUsuarioAsync(u.IdUsuario);
            if (error is not null)
            {
                avisos.Add(new ToastMessage
                {
                    Type = ToastType.Danger,
                    Title = bloquear ? "No se pudo bloquear" : "No se pudo reactivar",
                    Message = error
                });
                return;
            }
            await Recargar();
            if (bloquear)
                await listo.MostrarAsync("Cuenta bloqueada", $"{u.Nombres} {u.Apellidos} ya no podrá iniciar sesión.", "bi-lock-fill", rojo: true);
            else
                await listo.MostrarAsync("Cuenta reactivada", $"{u.Nombres} {u.Apellidos} ya puede volver a iniciar sesión.", "bi-unlock-fill");
        }
        finally
        {
            ocupado = false;
        }
    }
}
